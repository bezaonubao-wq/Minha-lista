.listas-form { flex-direction: column; gap: 14px; display: flex; }

.listas-campo { flex-direction: column; gap: 4px; display: flex; }

.listas-campo label { font-size: 0.85rem; font-weight: 600; }

.listas-campo input { width: 100%; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 14px; padding: 11px 14px; font-size: 0.92rem; }

.listas-campo input::placeholder { color: rgba(255, 255, 255, 0.35); }

