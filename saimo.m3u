.vod-episodios-cabecalho small { color: rgba(255, 255, 255, 0.55); margin-left: 10px; font-size: 0.85rem; font-weight: 500; display: inline-block; }

.vod-pilulas-grupo { flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 1.1rem; display: flex; }

.vod-pilula { appearance: none; cursor: pointer; color: rgba(255, 255, 255, 0.88); user-select: none; background: rgba(255, 255, 255, 0.12); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 999px; outline: none; justify-content: center; align-items: center; padding: 7px 18px; font-size: 0.88rem; font-weight: 600; transition: 0.16s; display: inline-flex; }

.vod-pilula:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.24); transform: translateY(-1px); }

.vod-pilula.ativa { color: rgb(11, 15, 25); background: rgb(255, 255, 255); font-weight: 700; box-shadow: rgba(255, 255, 255, 0.28) 0px 4px 14px; }

.vod-pilula-versao { padding: 5px 14px; font-size: 0.8rem; }

.vod-episodios-setas { align-items: center; gap: 6px; display: flex; }

.vod-seta-btn { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 50%; place-items: center; width: 32px; height: 32px; padding: 0px; font-size: 1.15rem; font-weight: 700; line-height: 1; transition: 0.15s; display: grid; }

.vod-seta-btn:hover { background: rgba(255, 255, 255, 0.26); border-color: rgba(255, 255, 255, 0.4); transform: scale(1.08); }

.vod-episodios-trilha { scroll-behavior: smooth; scrollbar-width: thin; gap: 16px; padding: 6px 4px 16px; display: flex; overflow-x: auto; }

.vod-episodios-trilha::-webkit-scrollbar { height: 6px; }

.vod-episodios-trilha::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 3px; }

.vod-ep-card { appearance: none; cursor: pointer; text-align: left; color: inherit; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; flex-direction: column; flex: 0 0 288px; gap: 8px; width: 288px; margin: 0px; padding: 0px; transition: transform 0.18s; display: flex; }

.vod-ep-card:hover { transform: translateY(-3px); }

.vod-ep-thumb { aspect-ratio: 16 / 9; background: rgb(20, 24, 36); border: 2px solid rgba(0, 0, 0, 0); border-radius: 10px; place-items: center; width: 288px; height: 162px; transition: border-color 0.18s, box-shadow 0.18s; display: grid; position: relative; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.45) 0px 6px 20px; }

.vod-ep-card:hover .vod-ep-thumb { border-color: rgba(255, 255, 255, 0.35); box-shadow: rgba(0, 0, 0, 0.6) 0px 8px 26px; }

.vod-ep-card.destaque .vod-ep-thumb { border-color: rgb(79, 227, 208); box-shadow: rgba(79, 227, 208, 0.35) 0px 0px 20px; }

.vod-ep-card.no-player .vod-ep-thumb { border-color: rgb(255, 51, 102); box-shadow: rgba(255, 51, 102, 0.4) 0px 0px 20px; }

.vod-ep-thumb img { object-fit: cover; width: 100%; height: 100%; display: block; }

.vod-ep-numero-grande { color: rgba(79, 227, 208, 0.55); text-shadow: rgba(0, 0, 0, 0.5) 0px 2px 10px; font-size: 2.8rem; font-weight: 800; }

.vod-ep-badge { z-index: 4; letter-spacing: 0.02em; border-radius: 999px; align-items: center; gap: 4px; padding: 4px 10px; font-size: 0.72rem; font-weight: 700; display: inline-flex; position: absolute; }

.vod-ep-badge.continuar { color: rgb(10, 11, 20); background: rgb(79, 227, 208); top: 8px; left: 8px; box-shadow: rgba(0, 0, 0, 0.4) 0px 2px 10px; }

.vod-ep-badge.assistido { color: rgb(79, 227, 208); background: rgba(0, 0, 0, 0.75); border: 1px solid rgba(79, 227, 208, 0.4); top: 8px; right: 8px; }

.vod-ep-progresso-trilho { z-index: 5; background: rgba(255, 255, 255, 0.25); height: 4px; position: absolute; bottom: 0px; left: 0px; right: 0px; }

.vod-ep-progresso-barra { background: rgb(79, 227, 208); height: 100%; transition: width 0.2s; }

.vod-ep-play-overlay { opacity: 0; z-index: 3; background: rgba(0, 0, 0, 0.35); place-items: center; transition: opacity 0.18s; display: grid; position: absolute; inset: 0px; }

.vod-ep-card:hover .vod-ep-play-overlay { opacity: 1; }

.vod-ep-play-circulo { color: rgb(11, 15, 25); background: rgba(255, 255, 255, 0.95); border-radius: 50%; place-items: center; width: 44px; height: 44px; transition: transform 0.15s; display: grid; transform: scale(0.9); box-shadow: rgba(0, 0, 0, 0.5) 0px 4px 16px; }

.vod-ep-card:hover .vod-ep-play-circulo { transform: scale(1); }

.vod-ep-play-circulo svg { width: 20px; height: 20px; margin-left: 2px; display: block; }

.vod-ep-info { flex-direction: column; gap: 3px; min-width: 0px; display: flex; }

.vod-ep-titulo { color: rgb(255, 255, 255); white-space: nowrap; text-overflow: ellipsis; margin: 0px; font-size: 0.92rem; font-weight: 600; line-height: 1.3; overflow: hidden; }

.vod-ep-meta { color: rgba(255, 255, 255, 0.55); font-size: 0.76rem; font-weight: 500; }

.vod-ep-sinopse { color: rgba(255, 255, 255, 0.65); -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin: 2px 0px 0px; font-size: 0.78rem; line-height: 1.35; display: -webkit-box; overflow: hidden; }

.vod-fontes-seletor { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 14px; margin-bottom: 2rem; padding: 1rem 1.2rem; }

.vod-fontes-seletor p { color: rgba(255, 255, 255, 0.7); margin: 0px 0px 10px; font-size: 0.86rem; font-weight: 600; }

.vod-fontes-lista { flex-wrap: wrap; gap: 10px; display: flex; }

.vod-fonte-item { color: rgb(255, 255, 255); cursor: pointer; text-align: left; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; justify-content: space-between; align-items: center; gap: 14px; padding: 8px 14px; transition: 0.15s; display: flex; }

.vod-fonte-item:hover { background: rgba(79, 227, 208, 0.15); border-color: rgb(79, 227, 208); }

.vod-fonte-item strong { font-size: 0.84rem; display: block; }

.vod-fonte-item small { color: rgba(255, 255, 255, 0.55); font-size: 0.74rem; }

.vod-fonte-item em { color: rgb(79, 227, 208); font-size: 0.78rem; font-style: normal; font-weight: 700; }

.vod-ficha-elenco h3 { margin: 0px 0px 1rem; font-size: 1.15rem; font-weight: 700; }

.vod-ficha-elenco ul { scrollbar-width: thin; gap: 16px; margin: 0px; padding-bottom: 10px; padding-left: 0px; list-style: none; display: flex; overflow-x: auto; }

.vod-ficha-elenco li button { width: 96px; color: inherit; cursor: pointer; text-align: center; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; flex-direction: column; align-items: center; gap: 6px; transition: transform 0.15s; display: flex; }

.vod-ficha-elenco li button:hover { transform: translateY(-4px); }

.vod-ficha-elenco img, .vod-ficha-sem-foto { object-fit: cover; background: rgba(255, 255, 255, 0.08); border-radius: 50%; width: 76px; height: 76px; box-shadow: rgba(0, 0, 0, 0.4) 0px 4px 16px; }

.vod-ficha-sem-foto { color: rgba(255, 255, 255, 0.35); place-items: center; font-size: 1.5rem; font-weight: 700; display: grid; }

.vod-ficha-elenco strong { -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 0.82rem; line-height: 1.2; display: -webkit-box; overflow: hidden; }

.vod-ficha-elenco small { color: rgba(255, 255, 255, 0.55); -webkit-line-clamp: 1; -webkit-box-orient: vertical; font-size: 0.72rem; display: -webkit-box; overflow: hidden; }

.vod-ator-tela { padding: 1.8rem; }

.vod-ator-barra { justify-content: space-between; align-items: center; margin-bottom: 1.5rem; display: flex; }

.vod-ator-topo { align-items: center; gap: 24px; margin-bottom: 2rem; display: flex; }

.vod-ator-foto { background: rgba(255, 255, 255, 0.08); border-radius: 50%; flex-shrink: 0; place-items: center; width: 120px; height: 120px; display: grid; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.5) 0px 8px 30px; }

.vod-ator-foto img { object-fit: cover; width: 100%; height: 100%; }

.vod-ator-dados h2 { margin: 0px 0px 6px; font-size: 2rem; font-weight: 800; }

.vod-ator-info-extra { color: rgb(79, 227, 208); margin: 0px 0px 6px; font-size: 0.88rem; }

.vod-ator-biografia { color: rgba(255, 255, 255, 0.75); -webkit-line-clamp: 3; -webkit-box-orient: vertical; margin: 0px; font-size: 0.9rem; line-height: 1.5; display: -webkit-box; overflow: hidden; }

.vod-ator-contagem { margin: 0px 0px 1rem; font-size: 1.15rem; font-weight: 700; }

.vod-ator-grade { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 14px; display: grid; }

@media (width <= 768px) {
  .vod-catalog { padding-top: 60px; }
  .vod-ficha-hero-corpo { text-align: center; flex-direction: column; align-items: center; }
  .vod-ficha-hero-capa { width: 160px; height: 240px; }
  .vod-ficha-selos, .vod-ficha-botoes { justify-content: center; }
  .vod-sub-barra { box-sizing: border-box; border-radius: 18px; flex-direction: column; align-items: stretch; gap: 8px; width: calc(100% - 20px); margin: 0.4rem 10px 0.8rem; padding: 8px 10px; display: flex; top: 8px; }
  .vod-sub-barra-pills { scrollbar-width: none; box-sizing: border-box; flex-wrap: nowrap; align-items: center; gap: 6px; width: 100%; padding: 2px 2px 4px; display: flex; overflow-x: auto; }
  .vod-sub-barra-pills::-webkit-scrollbar { display: none; }
  .vod-sub-pill { white-space: nowrap; min-width: max-content; padding: 6px 14px; font-size: 0.82rem; flex-shrink: 0 !important; }
  .vod-sub-barra-acoes { box-sizing: border-box; align-items: center; gap: 8px; width: 100%; display: flex; }
  .vod-sub-busca { box-sizing: border-box; flex: 1 1 0%; min-width: 0px; height: 36px; padding: 0px 12px; }
  .vod-sub-busca input { flex: 1 1 0%; min-width: 0px; font-size: 0.84rem; width: 100% !important; }
  .vod-sub-busca input:focus { width: 100% !important; }
  .vod-sub-btn-modo { flex-shrink: 0; height: 36px; padding: 0px 12px; font-size: 0.8rem; }
  .vod-letras-barra { scrollbar-width: none; flex-wrap: nowrap; margin: 0px 10px 0.8rem; padding: 6px 8px; overflow-x: auto; top: 108px !important; }
  .vod-letras-barra::-webkit-scrollbar { display: none; }
  .vod-letra-pill { flex-shrink: 0; }
}
