.series-modal .season-tab[data-focusable="true"].dpad-focused { background: var(--focus-ring-color); color: rgb(255, 255, 255); transform: scale(1.05); }

.series-modal .episode-card[data-focusable="true"].dpad-focused { background: linear-gradient(135deg, rgba(var(--focus-ring-color-rgb), .25), rgba(var(--focus-ring-color-rgb), .1)); box-shadow: -10px 0 30px rgba(var(--focus-ring-color-rgb), .4); transform: translate(10px); }

.series-modal .episode-card[data-focusable="true"].dpad-focused .episode-number { background: var(--focus-ring-color); transform: scale(1.1); }

.program-guide .program-item[data-focusable="true"].dpad-focused { background: linear-gradient(135deg, rgba(var(--focus-ring-color-rgb), .3), rgba(var(--focus-ring-color-rgb), .1)); border: 2px solid var(--focus-ring-color); z-index: 10; transform: scale(1.02); }

.program-guide .channel-row[data-focusable="true"].dpad-focused { background: rgba(var(--focus-ring-color-rgb), .1); border-left: 4px solid var(--focus-ring-color); }

.category-tabs .category-tab[data-focusable="true"].dpad-focused, .category-list .category-item[data-focusable="true"].dpad-focused { background: linear-gradient(135deg, var(--focus-ring-color), rgba(var(--focus-ring-color-rgb), .7)); color: rgb(255, 255, 255); box-shadow: 0 0 20px rgba(var(--focus-ring-color-rgb), .5); transform: scale(1.05); }

.featured-platforms .platform-card[data-focusable="true"].dpad-focused { box-shadow: 0 0 0 3px var(--focus-ring-color), 0 0 40px rgba(var(--focus-ring-color-rgb), .6), 0 15px 30px #0006; transform: scale(1.1); }

.content-nav .nav-btn[data-focusable="true"].dpad-focused, .content-nav .nav-btn[data-focusable="true"]:focus-visible { box-shadow: 0 0 20px rgba(var(--focus-ring-color-rgb), .5), inset 0 0 15px rgba(var(--focus-ring-color-rgb), .1); transform: scale(1.08); background: linear-gradient(135deg, rgba(var(--focus-ring-color-rgb), .3), rgba(var(--focus-ring-color-rgb), .1)) !important; border-color: var(--focus-ring-color) !important; }

.category-dropdown-btn[data-focusable="true"].dpad-focused, .category-dropdown-btn[data-focusable="true"]:focus-visible { box-shadow: 0 0 15px rgba(var(--focus-ring-color-rgb), .4); transform: scale(1.05); background: rgba(var(--focus-ring-color-rgb), .2) !important; border-color: var(--focus-ring-color) !important; }

.dropdown-item[data-focusable="true"].dpad-focused, .dropdown-item[data-focusable="true"]:focus-visible { box-shadow: -5px 0 15px rgba(var(--focus-ring-color-rgb), .3); transform: translate(5px); background: linear-gradient(135deg, rgba(var(--focus-ring-color-rgb), .3), rgba(var(--focus-ring-color-rgb), .1)) !important; color: rgb(255, 255, 255) !important; }

.category-chip[data-focusable="true"].dpad-focused, .category-chip[data-focusable="true"]:focus-visible { box-shadow: 0 0 20px rgba(var(--focus-ring-color-rgb), .5); transform: scale(1.05); background: var(--focus-ring-color) !important; color: rgb(255, 255, 255) !important; }

.see-all-categories-btn[data-focusable="true"].dpad-focused, .see-all-categories-btn[data-focusable="true"]:focus-visible, .see-all-btn[data-focusable="true"].dpad-focused, .see-all-btn[data-focusable="true"]:focus-visible { box-shadow: 0 0 20px rgba(var(--focus-ring-color-rgb), .5); transform: scale(1.08); background: rgba(var(--focus-ring-color-rgb), .2) !important; border-color: var(--focus-ring-color) !important; }

.carousel-nav[data-focusable="true"].dpad-focused, .carousel-nav[data-focusable="true"]:focus-visible { box-shadow: 0 0 25px rgba(var(--focus-ring-color-rgb), .7); transform: scale(1.2); background: rgba(var(--focus-ring-color-rgb), .8) !important; }

.load-more-card[data-focusable="true"].dpad-focused, .load-more-card[data-focusable="true"]:focus-visible { box-shadow: 0 0 30px rgba(var(--focus-ring-color-rgb), .5); transform: scale(1.05); background: linear-gradient(135deg, rgba(var(--focus-ring-color-rgb), .3), rgba(var(--focus-ring-color-rgb), .1)) !important; border-color: var(--focus-ring-color) !important; }

.reset-btn[data-focusable="true"].dpad-focused, .reset-btn[data-focusable="true"]:focus-visible { box-shadow: 0 0 25px rgba(var(--focus-ring-color-rgb), .6); transform: scale(1.08); background: var(--focus-ring-color) !important; }

.categories-modal .category-item[data-focusable="true"].dpad-focused, .categories-modal .category-item[data-focusable="true"]:focus-visible { box-shadow: 0 0 20px rgba(var(--focus-ring-color-rgb), .4); transform: scale(1.03); background: linear-gradient(135deg, rgba(var(--focus-ring-color-rgb), .3), rgba(var(--focus-ring-color-rgb), .15)) !important; border-color: var(--focus-ring-color) !important; }

.center-play[data-focusable="true"].dpad-focused, .center-play[data-focusable="true"]:focus-visible { box-shadow: 0 0 50px rgba(var(--focus-ring-color-rgb), .7), 0 0 100px rgba(var(--focus-ring-color-rgb), .4); transform: scale(1.2); background: rgba(var(--focus-ring-color-rgb), .4) !important; }

.skip-intro-btn[data-focusable="true"].dpad-focused, .skip-intro-btn[data-focusable="true"]:focus-visible { box-shadow: 0 0 30px rgba(var(--focus-ring-color-rgb), .7); transform: scale(1.1); background: var(--focus-ring-color) !important; }

.next-episode-btn[data-focusable="true"].dpad-focused, .next-episode-btn[data-focusable="true"]:focus-visible { box-shadow: 0 0 30px rgba(var(--focus-ring-color-rgb), .7); transform: scale(1.05); background: var(--focus-ring-color) !important; }

.next-dismiss-btn[data-focusable="true"].dpad-focused, .next-dismiss-btn[data-focusable="true"]:focus-visible { transform: scale(1.2); box-shadow: rgba(255, 255, 255, 0.3) 0px 0px 15px; background: rgba(255, 255, 255, 0.2) !important; }

.external-dropdown button[data-focusable="true"].dpad-focused, .external-dropdown button[data-focusable="true"]:focus-visible { transform: translate(5px); background: rgba(var(--focus-ring-color-rgb), .3) !important; }

.settings-dropdown select[data-focusable="true"].dpad-focused, .settings-dropdown select[data-focusable="true"]:focus-visible, .settings-dropdown input[data-focusable="true"].dpad-focused, .settings-dropdown input[data-focusable="true"]:focus-visible { box-shadow: 0 0 15px rgba(var(--focus-ring-color-rgb), .5); border-color: var(--focus-ring-color) !important; }

.video-player .control-bar button[data-focusable="true"].dpad-focused { background: rgba(var(--focus-ring-color-rgb), .3); box-shadow: 0 0 30px rgba(var(--focus-ring-color-rgb), .6); transform: scale(1.3); }

.video-player .progress-bar[data-focusable="true"].dpad-focused { box-shadow: 0 0 20px rgba(var(--focus-ring-color-rgb), .5); transform: scaleY(1.5); }

.dpad-navigation-hint { backdrop-filter: blur(10px); z-index: 9999; opacity: 0; background: rgba(0, 0, 0, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; align-items: center; gap: 20px; padding: 12px 24px; animation: 0.3s ease 1s 1 normal forwards running hintFadeIn; display: flex; position: fixed; bottom: 20px; left: 50%; transform: translate(-50%); }

@keyframes hintFadeIn { 
  100% { opacity: 1; }
}

.dpad-navigation-hint .hint-item { color: rgba(255, 255, 255, 0.7); align-items: center; gap: 8px; font-size: 0.85rem; display: flex; }

.dpad-navigation-hint .hint-key { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 6px; padding: 4px 10px; font-family: monospace; font-size: 0.8rem; }

.dpad-navigation-hint .hint-key svg { width: 16px; height: 16px; }

.dpad-navigation-hint.auto-hide { animation: 0.3s ease 0s 1 normal forwards running hintFadeIn, 0.3s ease 5s 1 normal forwards running hintFadeOut; }

@keyframes hintFadeOut { 
  100% { opacity: 0; pointer-events: none; }
}

[data-focusable="true"][disabled], [data-focusable="true"][data-disabled="true"], [data-focusable="true"].disabled { opacity: 0.5; pointer-events: none; }

.dpad-scroll-container { scroll-behavior: smooth; scroll-snap-type: y; }

.dpad-scroll-container > [data-focusable="true"] { scroll-snap-align: start; scroll-margin-top: 100px; }

@media (width >= 1400px) {
  :root { --focus-ring-width: 4px; --focus-glow-size: 30px; --focus-scale-card: 1.1; }
}

@media (pointer: coarse) {
  [data-focusable="true"].dpad-focused::before { --focus-ring-width: 4px; }
}

@media (prefers-reduced-motion: reduce) {
  [data-focusable="true"], [data-focusable="true"]::before { transition: none !important; animation: auto ease 0s 1 normal none running none !important; }
}

.focus-trap-container { position: relative; }

.focus-trap-container::before, .focus-trap-container::after { content: ""; opacity: 0; width: 1px; height: 1px; position: absolute; }

.modo-tv .dpad-focused { outline-offset: 3px; z-index: 5; border-radius: 10px; position: relative; box-shadow: rgba(167, 139, 250, 0.28) 0px 0px 0px 8px; outline: rgb(167, 139, 250) solid 5px !important; }

.modo-tv :focus { outline: none; }

.modo-tv .dpad-focused:focus { outline: rgb(167, 139, 250) solid 5px; }

.modo-tv .volume-slider-mac, .modo-tv .video-player-container [title^="Transmitir"], .modo-tv .video-player-container [title^="Picture in Picture"], .modo-tv .video-player-container [title^="Tela cheia"], .modo-tv .video-player-container [title^="Sair da tela cheia"] { display: none !important; }

.modo-tv * { }

.modo-tv .painel-de-canais-container { background: rgba(11, 14, 20, 0.98) !important; box-shadow: rgba(0, 0, 0, 0.8) 0px 12px 30px !important; }

.modo-tv .vod-sub-barra { background: rgba(18, 20, 34, 0.98) !important; }

.modo-tv .barra-topo-container { background: rgba(11, 14, 20, 0.98) !important; }

.abertura { z-index: 10000; opacity: 1; cursor: pointer; background: radial-gradient(60% 50% at 18% 30%, rgba(40, 110, 150, 0.35), rgba(0, 0, 0, 0) 70%), radial-gradient(55% 45% at 85% 78%, rgba(120, 50, 150, 0.38), rgba(0, 0, 0, 0) 70%), linear-gradient(160deg, rgb(21, 26, 69), rgb(11, 15, 42) 60%); place-items: center; transition: opacity 0.3s; display: grid; position: fixed; inset: 0px; }

.abertura.saindo { opacity: 0; pointer-events: none; }

.abertura-luz { width: 100%; height: 100%; position: absolute; inset: 0px; }

.abertura-logo { width: min(64vmin, 560px); height: auto; position: relative; overflow: visible; }

.tela { color: rgb(255, 255, 255); background: radial-gradient(circle at 80% -10%, rgba(163, 92, 240, 0.12), rgba(0, 0, 0, 0) 36rem), radial-gradient(circle at 10% 0px, rgba(79, 243, 224, 0.08), rgba(0, 0, 0, 0) 30rem), rgb(10, 11, 20); min-height: 100vh; padding-bottom: 4rem; }

.tela-miolo { padding: 0px clamp(1rem, 3vw, 3rem); }

.tela-titulo { letter-spacing: -0.02em; margin: 1.2rem 0px 0.4rem; font-size: 1.7rem; font-weight: 800; }

.tela-sub { color: rgba(255, 255, 255, 0.55); margin-bottom: 1rem; font-size: 0.92rem; }

.tela-vazio { text-align: center; color: rgba(255, 255, 255, 0.55); padding: 4rem 1rem; }

.tela-vazio h2 { color: rgb(255, 255, 255); margin-bottom: 0.4rem; font-size: 1.2rem; }

.sem-lista svg { opacity: 0.45; margin-bottom: 0.6rem; }

.sem-lista p { max-width: 34rem; margin: 0px auto; line-height: 1.5; }

.sem-lista-acao { color: rgb(10, 10, 10); font-style: inherit; font-variant: inherit; font-stretch: inherit; font-size: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; cursor: pointer; background: rgb(255, 255, 255); border: 0px; border-radius: 999px; margin-top: 1.1rem; padding: 0.65rem 1.4rem; font-weight: 600; }

.sem-lista-acao:hover, .sem-lista-acao:focus-visible { outline-offset: 2px; background: rgb(230, 230, 239); outline: rgba(255, 255, 255, 0.5) solid 2px; }

.heroi { align-items: flex-end; height: clamp(300px, 46vh, 460px); margin: -76px 0px 1.2rem; display: flex; position: relative; overflow: hidden; }

.heroi-vazio { background: linear-gradient(rgb(20, 22, 42), rgba(0, 0, 0, 0)); }

.heroi-fundo { object-fit: cover; object-position: center 20%; width: 100%; height: 100%; animation: 0.5s ease 0s 1 normal none running heroi-entra; position: absolute; inset: 0px; }

.heroi-fundo.borrado { filter: blur(34px) saturate(1.3); opacity: 0.65; transform: scale(1.3); }

@keyframes heroi-entra { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.heroi-vinheta { background: linear-gradient(90deg, rgba(10, 11, 20, 0.92) 0%, rgba(10, 11, 20, 0.55) 45%, rgba(0, 0, 0, 0) 75%), linear-gradient(rgba(0, 0, 0, 0) 55%, rgb(10, 11, 20) 100%); position: absolute; inset: 0px; }

.heroi-texto { z-index: 1; max-width: 760px; padding: 0px clamp(1rem, 3vw, 3rem) 2rem; position: relative; }

.heroi-selos { flex-wrap: wrap; gap: 8px; margin-bottom: 0.6rem; display: flex; }

.heroi-selos span { backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 12px; padding: 3px 10px; font-size: 0.74rem; font-weight: 700; }

.heroi h1 { letter-spacing: -0.03em; text-shadow: rgba(0, 0, 0, 0.6) 0px 2px 20px; font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 800; line-height: 1.05; }

.heroi p { color: rgba(255, 255, 255, 0.82); -webkit-line-clamp: 3; -webkit-box-orient: vertical; margin-top: 0.7rem; font-size: 0.95rem; line-height: 1.5; display: -webkit-box; overflow: hidden; }

.fileira { margin: 0px 0px 1.6rem; }

.fileira > header { justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; padding: 0px clamp(1rem, 3vw, 3rem); display: flex; }

.fileira h2 { letter-spacing: -0.01em; font-size: 1.15rem; font-weight: 700; }

.fileira-ver { color: rgb(79, 243, 224); border-radius: 10px; padding: 4px 8px; font-size: 0.82rem; font-weight: 600; }

.fileira-ver:hover { background: rgba(79, 243, 224, 0.12); }

.fileira-corpo { position: relative; }

.fileira-trilho { scroll-snap-type: x; scrollbar-width: none; gap: 14px; padding: 6px clamp(1rem, 3vw, 3rem) 10px; display: flex; overflow-x: auto; }

.fileira-trilho::-webkit-scrollbar { display: none; }

.fileira-seta { z-index: 3; color: rgb(255, 255, 255); opacity: 0; background: rgba(20, 22, 38, 0.6); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px; width: 44px; font-size: 2rem; line-height: 1; transition: opacity 0.15s; position: absolute; top: 8px; bottom: 36px; }

.fileira-seta.esq { left: 6px; }

.fileira-seta.dir { right: 6px; }

.fileira-corpo:hover .fileira-seta { opacity: 1; }

.fileira-seta:hover { background: rgba(79, 243, 224, 0.25); }

.cartao-capa { text-align: left; scroll-snap-align: start; flex-direction: column; flex: 0 0 auto; gap: 6px; width: 154px; display: flex; }

.cartao-capa-img { aspect-ratio: 2 / 3; background: linear-gradient(135deg, rgb(27, 30, 54), rgb(18, 20, 42)); border: 2px solid rgba(0, 0, 0, 0); border-radius: 14px; place-items: center; transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s; display: grid; position: relative; overflow: hidden; }

.cartao-capa-img span { color: rgba(255, 255, 255, 0.25); font-size: 2.2rem; font-weight: 800; }

.cartao-capa-img img { object-fit: cover; width: 100%; height: 100%; }

.cartao-capa:hover .cartao-capa-img, .cartao-capa:focus-visible .cartao-capa-img { border-color: rgb(79, 243, 224); transform: translateY(-4px); box-shadow: rgba(79, 243, 224, 0.22) 0px 10px 28px; }

.cartao-capa strong { -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 0.84rem; font-weight: 600; line-height: 1.25; display: -webkit-box; overflow: hidden; }

.cartao-capa small { color: rgba(255, 255, 255, 0.55); font-size: 0.74rem; }

.cartao-capa-prog, .cartao-largo-prog { background: rgba(255, 255, 255, 0.2); height: 4px; position: absolute; bottom: 0px; left: 0px; right: 0px; }

.cartao-capa-prog b, .cartao-largo-prog b { background: rgb(79, 243, 224); height: 100%; display: block; }

.cartao-capa-coracao { color: rgb(255, 93, 122); background: rgba(0, 0, 0, 0.55); border-radius: 50%; place-items: center; width: 28px; height: 28px; font-size: 0.9rem; display: grid; position: absolute; top: 6px; right: 6px; }

.cartao-largo { text-align: left; scroll-snap-align: start; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 18px; flex-direction: column; flex: 0 0 auto; gap: 4px; width: 248px; padding: 16px 14px 18px; transition: transform 0.18s, border-color 0.18s, background 0.18s; display: flex; position: relative; overflow: hidden; }

.cartao-largo:hover, .cartao-largo:focus-visible { background: rgba(79, 243, 224, 0.08); border-color: rgb(79, 243, 224); transform: translateY(-3px); }

.cartao-largo-logo { background: rgba(255, 255, 255, 0.05); border-radius: 12px; place-items: center; height: 74px; margin-bottom: 6px; display: grid; }

.cartao-largo-logo img { object-fit: contain; max-width: 70%; max-height: 58px; }

.cartao-largo-logo span { color: rgba(255, 255, 255, 0.3); font-size: 1.8rem; font-weight: 800; }

.cartao-largo strong { white-space: nowrap; text-overflow: ellipsis; font-size: 0.92rem; font-weight: 700; overflow: hidden; }

.cartao-largo small { color: rgba(255, 255, 255, 0.6); white-space: nowrap; text-overflow: ellipsis; font-size: 0.78rem; overflow: hidden; }

.selo-vivo { z-index: 2; letter-spacing: 0.04em; background: rgb(229, 72, 77); border-radius: 10px; align-items: center; gap: 5px; padding: 2px 8px; font-size: 0.64rem; font-style: normal; font-weight: 800; display: flex; position: absolute; top: 10px; left: 10px; }

.selo-vivo i { background: rgb(255, 255, 255); border-radius: 50%; width: 6px; height: 6px; animation: 1.2s ease 0s infinite normal none running selo-pulsa; }

@keyframes selo-pulsa { 
  50% { opacity: 0.3; }
}

.campo-busca { color: rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 22px; align-items: center; gap: 10px; height: 44px; padding: 0px 14px; display: flex; }

.campo-busca:focus-within { color: rgb(255, 255, 255); border-color: rgb(79, 243, 224); }

.campo-busca svg { flex-shrink: 0; width: 18px; height: 18px; }

.campo-busca input { color: rgb(255, 255, 255); flex: 1 1 0%; min-width: 0px; font-size: 1rem; }

.campo-busca button { color: rgba(255, 255, 255, 0.6); padding: 0px 4px; font-size: 1.3rem; }

.pilulas { flex-wrap: wrap; gap: 8px; margin: 0.6rem 0px 1.2rem; display: flex; }

.pilulas button { color: rgba(255, 255, 255, 0.75); background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 6px 14px; font-size: 0.82rem; font-weight: 600; }

.pilulas button:hover { background: rgba(255, 255, 255, 0.13); }

.pilulas button.on { color: rgb(255, 255, 255); background: linear-gradient(135deg, rgba(79, 243, 224, 0.3), rgba(163, 92, 240, 0.35)); border-color: rgba(255, 255, 255, 0.25); }

@media (width <= 768px) {
  .heroi { height: 260px; margin-top: 0px; }
  .tela-com-barra { padding-top: 0px; }
}

.grade-titulo { margin: 1.4rem 0px 0.7rem; font-size: 1.1rem; font-weight: 700; }

.grade { flex-wrap: wrap; gap: 16px; display: flex; }

.grade-item { position: relative; }

.grade-tirar { z-index: 4; color: rgb(255, 93, 122); opacity: 0; background: rgba(0, 0, 0, 0.6); border-radius: 50%; place-items: center; width: 30px; height: 30px; font-size: 0.95rem; transition: opacity 0.15s, transform 0.15s; display: grid; position: absolute; top: 8px; right: 8px; }

.grade-item:hover .grade-tirar { opacity: 1; }

.grade-tirar:hover { background: rgba(0, 0, 0, 0.85); transform: scale(1.12); }

.equalizador { align-items: flex-end; gap: 3px; height: 28px; display: flex; position: absolute; bottom: 8px; left: 8px; }

.equalizador i { background: rgb(79, 243, 224); border-radius: 2px; width: 4px; animation: 0.9s ease-in-out 0s infinite normal none running eq; }

.equalizador i:nth-child(2) { background: rgb(163, 92, 240); animation-delay: -0.3s; }

.equalizador i:nth-child(3) { animation-delay: -0.6s; }

.equalizador i:nth-child(4) { background: rgb(163, 92, 240); animation-delay: -0.15s; }

@keyframes eq { 
  0%, 100% { height: 20%; }
  50% { height: 100%; }
}

.ev-cartao { text-align: left; scroll-snap-align: start; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 18px; flex-direction: column; flex: 0 0 auto; gap: 14px; width: 300px; padding: 14px 16px; transition: transform 0.18s, border-color 0.18s, background 0.18s; display: flex; }

.ev-cartao:hover, .ev-cartao:focus-visible { background: rgba(79, 243, 224, 0.08); border-color: rgb(79, 243, 224); transform: translateY(-3px); }

.ev-cartao.vivo { border-color: rgba(229, 72, 77, 0.55); }

.ev-cartao header { justify-content: space-between; align-items: center; gap: 8px; display: flex; }

.ev-liga { color: rgba(255, 255, 255, 0.65); align-items: center; gap: 6px; min-width: 0px; font-size: 0.74rem; font-weight: 600; display: flex; }

.ev-liga img { object-fit: contain; flex-shrink: 0; width: 18px; height: 18px; }

.ev-selo { background: rgba(255, 255, 255, 0.12); border-radius: 10px; flex-shrink: 0; align-items: center; gap: 5px; padding: 2px 9px; font-size: 0.68rem; font-style: normal; font-weight: 800; display: flex; }

.ev-selo.vivo { background: rgb(229, 72, 77); }

.ev-selo i { background: rgb(255, 255, 255); border-radius: 50%; width: 6px; height: 6px; animation: 1.2s ease 0s infinite normal none running selo-pulsa; }

.ev-times { grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; display: grid; }

.ev-times > div { flex-direction: column; align-items: center; gap: 6px; min-width: 0px; display: flex; }

.ev-times img, .ev-sem-escudo { object-fit: contain; width: 52px; height: 52px; }

.ev-sem-escudo { background: rgba(255, 255, 255, 0.1); border-radius: 50%; place-items: center; font-size: 1.4rem; font-weight: 800; display: grid; }

.ev-times span { text-align: center; -webkit-line-clamp: 2; -webkit-box-orient: vertical; max-width: 100%; font-size: 0.78rem; font-weight: 600; line-height: 1.2; display: -webkit-box; overflow: hidden; }

.ev-times b { color: rgb(79, 243, 224); font-variant-numeric: tabular-nums; font-size: 1.3rem; font-weight: 800; }

.ev-cartao footer { color: rgba(255, 255, 255, 0.7); border-top: 1px solid rgba(255, 255, 255, 0.08); align-items: center; gap: 8px; padding-top: 10px; font-size: 0.78rem; display: flex; }

.ev-cartao footer img { object-fit: contain; max-width: 40px; height: 18px; }

.radio-topo { flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; padding: 1rem 0px 1.6rem; display: flex; }

.radio-topo .campo-busca { width: min(340px, 100%); }

.radio-agora { align-items: center; gap: 16px; min-width: 0px; display: flex; }

.radio-agora small { letter-spacing: 0.06em; text-transform: uppercase; color: rgb(79, 243, 224); font-size: 0.74rem; font-weight: 700; }

.radio-agora h1 { letter-spacing: -0.02em; font-size: 1.8rem; font-weight: 800; line-height: 1.1; }

.radio-agora p { color: rgba(255, 255, 255, 0.6); font-size: 0.86rem; }

.radio-agora-logo { background: rgba(255, 255, 255, 0.08); border-radius: 20px; flex-shrink: 0; place-items: center; width: 84px; height: 84px; display: grid; overflow: hidden; }

.radio-agora-logo img { object-fit: contain; width: 80%; height: 80%; }

.radio-agora-logo span { color: rgba(255, 255, 255, 0.3); font-size: 2rem; font-weight: 800; }

.radio-parar { background: rgba(229, 72, 77, 0.2); border: 1px solid rgba(229, 72, 77, 0.5); border-radius: 18px; padding: 8px 18px; font-size: 0.84rem; font-weight: 700; }

.radio-parar:hover { background: rgba(229, 72, 77, 0.4); }

.cartao-radio { text-align: center; scroll-snap-align: start; flex-direction: column; flex: 0 0 auto; gap: 8px; width: 132px; display: flex; }

.cartao-radio-logo { background: rgba(255, 255, 255, 0.07); border: 2px solid rgba(0, 0, 0, 0); border-radius: 22px; place-items: center; width: 132px; height: 132px; transition: transform 0.18s, border-color 0.18s; display: grid; position: relative; overflow: hidden; }

.cartao-radio-logo img { object-fit: contain; width: 78%; height: 78%; }

.cartao-radio-logo span { color: rgba(255, 255, 255, 0.28); font-size: 2.4rem; font-weight: 800; }

.cartao-radio:hover .cartao-radio-logo, .cartao-radio.tocando .cartao-radio-logo { border-color: rgb(79, 243, 224); transform: translateY(-3px); }

.cartao-radio strong { -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 0.82rem; font-weight: 600; line-height: 1.25; display: -webkit-box; overflow: hidden; }

.cartao-radio-logo .toast { backdrop-filter: blur(10px); cursor: pointer; z-index: 1000; background: rgba(30, 30, 30, 0.95); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; align-items: center; gap: 12px; padding: 14px 20px; animation: 0.3s ease 0s 1 normal none running slideIn, 0.3s ease 2.7s 1 normal forwards running fadeOut; display: flex; position: fixed; bottom: 24px; right: 24px; box-shadow: rgba(0, 0, 0, 0.4) 0px 10px 40px; }

@keyframes slideIn { 
  0% { opacity: 0; transform: translate(100%); }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes fadeOut { 
  0% { opacity: 1; }
  100% { opacity: 0; visibility: hidden; }
}

.toast-icon { flex-shrink: 0; width: 24px; height: 24px; }

.toast-icon svg { width: 100%; height: 100%; }

.toast-success .toast-icon { color: rgb(34, 197, 94); }

.toast-error .toast-icon { color: rgb(239, 68, 68); }

.toast-info .toast-icon { color: rgb(59, 130, 246); }

.toast-message { color: rgb(255, 255, 255); font-size: 14px; font-weight: 500; }

@media (width <= 768px) {
  .toast { gap: 10px; padding: 12px 16px; bottom: 16px; left: 16px; right: 16px; }
  .toast-icon { width: 20px; height: 20px; }
  .toast-message { font-size: 13px; }
}

@media (width <= 480px) {
  .toast { border-radius: 10px; padding: 10px 14px; bottom: 10px; left: 10px; right: 10px; }
  .toast-icon { width: 18px; height: 18px; }
  .toast-message { font-size: 12px; }
}

.events-modal-overlay { z-index: 9999; backdrop-filter: blur(8px); background: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; padding: 40px 20px; animation: 0.3s ease 0s 1 normal none running fadeIn; display: flex; position: fixed; inset: 0px; }

@keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.events-modal-container { background: var(--ground); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; width: 100%; max-width: 1300px; height: 95vh; padding: 40px; animation: 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal none running slideUp; position: relative; overflow-y: auto; box-shadow: rgba(0, 0, 0, 0.5) 0px 25px 50px -12px; }

@keyframes slideUp { 
  0% { opacity: 0; transform: translateY(40px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.events-close-btn { color: rgb(255, 255, 255); cursor: pointer; z-index: 10; background: rgba(255, 255, 255, 0.1); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; justify-content: center; align-items: center; width: 48px; height: 48px; transition: 0.2s; display: flex; position: absolute; top: 24px; right: 24px; }

.events-close-btn:hover { color: rgb(244, 63, 94); background: rgba(236, 72, 153, 0.2); transform: rotate(90deg); }

.events-header { text-align: center; margin-bottom: 40px; }

.events-header h1 { background: linear-gradient(135deg, rgb(139, 92, 246), rgb(236, 72, 153)) text; -webkit-text-fill-color: transparent; margin-bottom: 12px; font-size: 2.5rem; font-weight: 800; display: inline-block; }

.events-header p { color: var(--on-ground-variant); font-size: 1.1rem; }

.events-loading, .events-error, .events-empty { text-align: center; background: var(--surface); color: var(--on-surface-variant); border-radius: 20px; padding: 60px; font-size: 1.2rem; }

.events-grid { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; display: grid; }

.event-card { appearance: none; width: 100%; font: inherit; color: inherit; text-align: left; cursor: pointer; background: var(--surface); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 20px; flex-direction: column; gap: 20px; padding: 24px; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s; display: flex; position: relative; overflow: hidden; }

.event-card:hover { border-color: rgba(139, 92, 246, 0.3); transform: translateY(-5px); box-shadow: rgba(139, 92, 246, 0.2) 0px 10px 40px -10px; }

.event-card.is-live { background: linear-gradient(180deg, var(--surface) 0%, #ec48990d 100%); border-color: rgba(236, 72, 153, 0.2); }

.event-card-header { justify-content: space-between; align-items: center; display: flex; }

.event-league { color: var(--on-surface-variant); align-items: center; gap: 10px; font-size: 0.9rem; font-weight: 600; display: flex; }

.event-league img { object-fit: contain; background: rgba(255, 255, 255, 0.1); border-radius: 4px; width: 24px; height: 24px; padding: 2px; }

.event-badge { text-transform: uppercase; border-radius: 12px; align-items: center; gap: 6px; padding: 4px 10px; font-size: 0.75rem; font-weight: 700; display: flex; }

.event-badge.live { color: rgb(244, 63, 94); background: rgba(236, 72, 153, 0.15); }

.event-badge.upnext { color: rgb(167, 139, 250); background: rgba(139, 92, 246, 0.15); }

.event-badge.ended { color: rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.1); }

.pulse { background: rgb(244, 63, 94); border-radius: 50%; width: 6px; height: 6px; animation: 1.5s ease 0s infinite normal none running pulse; display: block; }

@keyframes pulse { 
  0% { transform: scale(0.95); box-shadow: rgba(244, 63, 94, 0.7) 0px 0px; }
  70% { transform: scale(1); box-shadow: rgba(244, 63, 94, 0) 0px 0px 0px 6px; }
  100% { transform: scale(0.95); box-shadow: rgba(244, 63, 94, 0) 0px 0px; }
}

.event-teams { justify-content: space-between; align-items: center; padding: 10px 0px; display: flex; }

.team { text-align: center; flex-direction: column; flex: 1 1 0%; align-items: center; gap: 12px; display: flex; }

.team img { object-fit: contain; filter: drop-shadow(rgba(0, 0, 0, 0.3) 0px 4px 8px); width: 64px; height: 64px; }

.team span { font-size: 0.95rem; font-weight: 600; line-height: 1.2; }

.team-vs { color: var(--on-surface-variant); opacity: 0.5; padding: 0px 16px; font-size: 1rem; font-weight: 800; }

.event-footer { flex-direction: column; gap: 16px; margin-top: auto; display: flex; }

.event-title { text-align: center; color: var(--on-surface); opacity: 0.9; margin: 0px; font-size: 1.1rem; }

.btn-watch { color: rgb(255, 255, 255); cursor: pointer; background: linear-gradient(135deg, rgb(139, 92, 246), rgb(99, 102, 241)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; justify-content: center; align-items: center; gap: 8px; width: 100%; padding: 14px; font-size: 1rem; font-weight: 700; transition: transform 0.2s, filter 0.2s; display: flex; }

.btn-watch svg { width: 20px; height: 20px; }

.btn-watch:hover:not(.disabled) { filter: brightness(1.1); transform: scale(1.02); }

.btn-watch.disabled { color: rgba(255, 255, 255, 0.3); cursor: not-allowed; background: rgba(255, 255, 255, 0.1); }

.events-grupo + .events-grupo { margin-top: 36px; }

.events-grupo-titulo { color: var(--on-ground); align-items: center; gap: 10px; margin: 0px 0px 16px; font-size: 1.25rem; font-weight: 700; display: flex; }

.team-placar { white-space: nowrap; color: var(--on-surface); padding: 0px 12px; font-size: 1.9rem; font-weight: 900; }

.team-placar.vivo { color: rgb(255, 255, 255); }

.team-sem-escudo { width: 64px; height: 64px; color: var(--on-surface-variant); background: rgba(255, 255, 255, 0.06); border-radius: 50%; justify-content: center; align-items: center; font-size: 1.5rem; font-weight: 800; display: flex; }

.event-canal { background: rgba(255, 255, 255, 0.05); border-radius: 14px; align-items: center; gap: 12px; margin-top: auto; padding: 10px 12px; display: flex; }

.event-canal img, .event-canal-sem-logo { object-fit: contain; flex: 0 0 auto; width: 44px; height: 28px; }

.event-canal-nome { text-overflow: ellipsis; white-space: nowrap; flex: 1 1 0%; min-width: 0px; font-weight: 600; overflow: hidden; }

.event-canal .btn-watch { border-radius: 999px; width: auto; padding: 8px 14px; font-size: 0.9rem; }

.event-card:hover .btn-watch { filter: brightness(1.1); }

.event-card:focus-visible { outline-offset: 2px; outline: rgb(167, 139, 250) solid 2px; }

@media (width <= 768px) {
  .events-modal-overlay { padding: 0px; }
  .events-modal-container { border-radius: 0px; height: 100vh; padding: 20px 16px; }
  .events-close-btn { background: rgba(0, 0, 0, 0.5); top: 16px; right: 16px; }
  .events-header { margin-top: 40px; }
  .events-header h1 { font-size: 2rem; }
  .event-card { padding: 20px; }
  .team img, .team-sem-escudo { width: 48px; height: 48px; }
  .team-placar { font-size: 1.5rem; }
}

.navegacao-mobile { display: none; }

@media (width <= 768px) {
  .navegacao-mobile { z-index: 900; padding: 6px 6px calc(6px + env(safe-area-inset-bottom)); background: rgba(10, 10, 14, 0.94); border-top: 1px solid rgba(255, 255, 255, 0.08); grid-template-columns: repeat(5, 1fr); display: grid; position: fixed; bottom: 0px; left: 0px; right: 0px; }
  .navegacao-mobile-item { color: rgba(255, 255, 255, 0.55); min-height: 52px; font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; background: 0px 0px; border: 0px; border-radius: 12px; flex-direction: column; justify-content: center; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; transition: color 0.15s, background 0.15s; display: flex; }
  .navegacao-mobile-item svg { width: 22px; height: 22px; }
  .navegacao-mobile-item:active { background: rgba(255, 255, 255, 0.06); }
  .navegacao-mobile-item.ativa { color: rgb(255, 255, 255); }
  .navegacao-mobile-item.ativa svg { color: rgb(167, 139, 250); }
  body { padding-bottom: calc(68px + env(safe-area-inset-bottom)); }
  :is(body:has(.movie-player-overlay) .navegacao-mobile, body:has(.tv-page.theater-mode) .navegacao-mobile, body:has(:fullscreen) .navegacao-mobile) { display: none; }
  :is(body:has(.movie-player-overlay), body:has(.tv-page.theater-mode)) { padding-bottom: 0px; }
}

.page-container { background: rgb(10, 10, 10); flex-direction: column; min-height: 100dvh; display: flex; }

.tv-page { background: rgb(0, 0, 0); width: 100vw; height: 100dvh; padding-top: 0px; position: fixed; inset: 0px; overflow: hidden; }

.tv-page.theater-mode { background: rgb(0, 0, 0); }

.stage-aovivo-mac { background: rgb(0, 0, 0); width: 100%; height: 100%; display: flex; position: absolute; inset: 0px; overflow: hidden; }

.multitela-stage-mac { background: rgb(0, 0, 0); gap: 3px; width: 100%; height: 100%; display: flex; position: relative; }

.multitela-lado-mac { cursor: pointer; box-sizing: border-box; background: rgb(0, 0, 0); flex: 1 1 0%; height: 100%; display: flex; position: relative; overflow: hidden; }

.multitela-lado-mac.ativo { box-shadow: rgb(79, 227, 208) 0px 0px 0px 3px inset; }

.multitela-moldura-mac { z-index: 120; pointer-events: none; opacity: 0; justify-content: space-between; align-items: center; transition: opacity 0.22s; display: flex; position: absolute; top: 76px; left: 16px; right: 16px; }

.multitela-moldura-mac.visivel { opacity: 1; }

.multitela-rotulo-mac { color: rgb(255, 255, 255); user-select: none; background: rgba(11, 14, 20, 0.78); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 999px; align-items: center; gap: 8px; padding: 6px 14px; font-size: 13px; font-weight: 600; display: flex; }

.multitela-som-icone { font-size: 12px; }

.multitela-badge { color: rgb(79, 227, 208); letter-spacing: 0.3px; background: rgba(79, 243, 224, 0.2); border-radius: 6px; padding: 2px 7px; font-size: 10px; font-weight: 700; }

.multitela-fechar { pointer-events: auto; color: rgb(255, 255, 255); cursor: pointer; background: rgba(11, 14, 20, 0.78); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 50%; justify-content: center; align-items: center; width: 28px; height: 28px; font-size: 12px; transition: 0.15s; display: flex; }

.multitela-fechar:hover { color: rgb(239, 68, 68); background: rgba(239, 68, 68, 0.3); border-color: rgb(239, 68, 68); transform: scale(1.1); }

.multitela-cartao-flutuante { z-index: 120; opacity: 0; pointer-events: none; transition: opacity 0.22s, padding-left 0.3s cubic-bezier(0.16, 1, 0.3, 1); position: absolute; bottom: 80px; right: 22px; }

.multitela-cartao-flutuante.visivel { opacity: 1; pointer-events: auto; }

.multitela-lado-mac.vazio { background: rgb(8, 12, 20); }

.multitela-badge.vazio { color: rgb(250, 204, 21); background: rgba(234, 179, 8, 0.2); }

.multitela-placeholder-escolha { box-sizing: border-box; cursor: pointer; user-select: none; background: radial-gradient(circle, rgba(79, 243, 224, 0.06) 0%, rgba(10, 14, 20, 0.95) 70%, rgb(6, 8, 12) 100%); border: 2px dashed rgba(79, 243, 224, 0.25); border-radius: 16px; justify-content: center; align-items: center; width: 100%; height: 100%; margin: 12px; transition: 0.25s cubic-bezier(0.16, 1, 0.3, 1); display: flex; }

.multitela-placeholder-escolha:hover { background: radial-gradient(circle, rgba(79, 243, 224, 0.1) 0%, rgba(10, 14, 20, 0.95) 70%, rgb(6, 8, 12) 100%); border-color: rgba(79, 243, 224, 0.55); box-shadow: rgba(79, 243, 224, 0.15) 0px 0px 35px; }

.multitela-placeholder-conteudo { text-align: center; flex-direction: column; align-items: center; gap: 14px; max-width: 380px; padding: 32px 24px; display: flex; }

.multitela-placeholder-icone { color: rgb(79, 227, 208); background: rgba(79, 243, 224, 0.1); border: 1px solid rgba(79, 243, 224, 0.3); border-radius: 22px; justify-content: center; align-items: center; width: 72px; height: 72px; animation: 2.4s ease-in-out 0s infinite normal none running pulsarIconeMultiTela; display: flex; box-shadow: rgba(79, 243, 224, 0.18) 0px 8px 28px; }

.multitela-placeholder-icone svg { width: 36px; height: 36px; }

@keyframes pulsarIconeMultiTela { 
  0%, 100% { transform: scale(1); box-shadow: rgba(79, 243, 224, 0.18) 0px 8px 28px; }
  50% { transform: scale(1.06); box-shadow: rgba(79, 243, 224, 0.32) 0px 14px 36px; }
}

.multitela-placeholder-titulo { color: rgb(255, 255, 255); letter-spacing: -0.01em; margin: 0px; font-size: 20px; font-weight: 700; }

.multitela-placeholder-desc { color: rgb(148, 163, 184); margin: 0px; font-size: 14px; line-height: 1.5; }

.multitela-btn-abrir-canais { color: rgb(11, 15, 25); cursor: pointer; background: linear-gradient(135deg, rgb(79, 227, 208), rgb(14, 165, 233)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 999px; align-items: center; gap: 8px; margin-top: 6px; padding: 10px 22px; font-size: 14px; font-weight: 700; transition: 0.2s cubic-bezier(0.16, 1, 0.3, 1); display: inline-flex; box-shadow: rgba(79, 243, 224, 0.3) 0px 4px 18px; }

.multitela-btn-abrir-canais:hover { transform: translateY(-2px) scale(1.02); box-shadow: rgba(79, 243, 224, 0.45) 0px 6px 24px; }

.movies-page { overflow: visible; }

.movies-page .catalog-container { flex-direction: column; flex: 1 1 0%; min-height: 0px; display: flex; }

.movies-page.playing { padding-top: 64px; }

.movies-page .movie-player-container { background: rgb(0, 0, 0); flex-direction: column; flex: 1 1 0%; justify-content: center; align-items: center; min-height: 0px; display: flex; overflow: hidden; }

.mobile-content { flex: 1 1 0%; min-height: 0px; display: none; position: relative; }

.desktop-only { display: flex; }

.mobile-overlay { z-index: 99; background: rgba(0, 0, 0, 0.7); animation: 0.2s ease 0s 1 normal none running fadeIn; display: none; position: fixed; inset: 0px; }

@media (width <= 768px) {
  body:has(.tv-page) { padding-bottom: 0px; }
  .tv-page { padding-top: 52px; }
  .tv-page.theater-mode { padding-top: 0px; }
  .tv-layout { height: calc(100dvh - 52px - 65px - env(safe-area-inset-bottom)); flex-direction: column; flex: 0 0 auto; max-height: none; }
  .tv-page.theater-mode .tv-layout { height: 100dvh; max-height: none; }
  .movies-page.playing { padding-top: 52px; }
  .desktop-only { display: none !important; }
  .mobile-content { flex-direction: column; flex: 1 1 0%; width: 100%; min-height: 0px; display: flex; }
  .mobile-player { aspect-ratio: 16 / 9; background: rgb(0, 0, 0); flex: 0 0 auto; width: 100%; position: relative; }
  .mobile-player > * { height: 100%; }
  .tv-page:not(.theater-mode) .mobile-player .program-description, .tv-page:not(.theater-mode) .mobile-player .next-program { display: none; }
  .tv-page:not(.theater-mode) .mobile-player .program-content { flex-direction: row; justify-content: space-between; align-items: flex-start; }
  .tv-page:not(.theater-mode) .mobile-player .program-actions { width: auto; }
  .tv-page.theater-mode .mobile-player { aspect-ratio: auto; flex: 1 1 0%; }
  .tv-page.theater-mode .mobile-canais { display: none; }
  .mobile-canais { background: rgb(10, 10, 10); flex-direction: column; flex: 1 1 0%; min-height: 0px; display: flex; position: relative; overflow: hidden; }
  .mobile-overlay { display: block; }
  .sidebar-wrapper { transition: transform 0.3s; position: fixed; top: 52px; bottom: 65px; left: 0px; transform: translate(-100%); }
  .sidebar-wrapper.open { transform: translate(0px); }
  .main-content { flex: 1 1 0%; min-height: 0px; }
}

.theater-mode .app-header { display: none; }

.movies-page .catalog-container.hidden-catalog { visibility: hidden; pointer-events: none; position: fixed; }

.movie-player-overlay { z-index: 1000; background: rgb(0, 0, 0); flex-direction: column; display: flex; position: fixed; inset: 0px; }

.movie-player-overlay .movie-player-container { background: rgb(0, 0, 0); flex-direction: column; flex: 1 1 0%; justify-content: center; align-items: center; min-height: 0px; padding-top: 0px; display: flex; overflow: hidden; }

.tv-page.deitado .desktop-only { display: none !important; }

.tv-page.deitado .mobile-content { flex-direction: column; flex: 1 1 0%; width: 100%; min-height: 0px; display: flex; }

.tv-page.deitado .mobile-canais { background: rgb(10, 10, 10); flex-direction: column; flex: 1 1 0%; min-height: 0px; display: flex; position: relative; overflow: hidden; }

.tv-page.deitado.tocando .mobile-player { z-index: 1100; aspect-ratio: auto; background: rgb(0, 0, 0); width: 100%; height: 100%; position: fixed; inset: 0px; }

.tv-page.deitado.tocando .mobile-player > * { height: 100%; }

.tv-page.deitado.tocando .mobile-canais, .tv-page.deitado.tocando .app-header { display: none; }

body:has(.tv-page.deitado.tocando) .navegacao-mobile { display: none; }

html[data-upscaling="hd"] .video-element:not([data-nativo="1"]), html[data-upscaling="hd"] .movie-player video:not([data-nativo="1"]), html[data-upscaling="hd"] video.movie-video:not([data-nativo="1"]), html[data-upscaling="hd"] .movie-video:not([data-nativo="1"]) { filter: url("#saimo-upscale-hd") contrast(1.02) saturate(1.03); }

