.ajustes-botoes { flex-wrap: wrap; gap: 8px; margin-top: 10px; display: flex; }

.ajustes-botao { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; padding: 8px 16px; font-size: 0.84rem; font-weight: 600; display: inline-block; }

.ajustes-botao:hover { background: rgba(255, 255, 255, 0.15); }

.ajustes-aviso { z-index: 950; backdrop-filter: blur(16px); background: rgba(20, 22, 38, 0.85); border: 1px solid rgb(79, 243, 224); border-radius: 20px; padding: 10px 20px; font-weight: 600; position: fixed; bottom: 28px; left: 50%; transform: translate(-50%); }

.ajustes-atalhos { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px 20px; margin-top: 10px; display: grid; }

.ajustes-atalhos > div { align-items: center; gap: 10px; font-size: 0.86rem; display: flex; }

.ajustes-atalhos dt { min-width: 64px; }

.ajustes-atalhos dd { color: rgba(255, 255, 255, 0.7); margin: 0px; }

.ajustes-atalhos kbd { background: rgba(255, 255, 255, 0.12); border-radius: 6px; padding: 2px 8px; font-family: inherit; font-size: 0.78rem; }

.minhas-listas-itens { gap: 8px; margin: 8px 0px 14px; padding: 0px; list-style: none; display: grid; }

.minhas-listas-itens li { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 14px; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 14px; display: flex; }

.minhas-listas-itens li.desativada { opacity: 0.6; }

.minhas-listas-nome { gap: 2px; min-width: 0px; display: grid; }

.minhas-listas-nome strong { text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }

.minhas-listas-nome small { color: rgba(255, 255, 255, 0.55); font-size: 0.76rem; }

.minhas-listas-acoes { flex-wrap: wrap; gap: 6px; display: flex; }

.minhas-listas-acoes .listas-botao { padding: 6px 12px; font-size: 0.8rem; }

.minhas-listas-acoes .listas-botao.perigo { color: rgb(252, 165, 165); }

.chuva-apoiadores-container { pointer-events: none; user-select: none; z-index: 0; width: 100%; height: 100%; position: fixed; inset: 0px; overflow: hidden; }

.chuva-apoiadores-container.pausada .chuva-item { animation-play-state: paused !important; }

.chuva-item { white-space: nowrap; letter-spacing: -0.01em; will-change: transform, opacity; font-family: inherit; animation-timing-function: ease; animation-fill-mode: forwards; position: absolute; bottom: -60px; }

.chuva-estrela { vertical-align: middle; opacity: 0.95; filter: drop-shadow(rgba(255, 60, 60, 0.8) 0px 0px 6px); margin-left: 6px; font-size: 0.65em; }

@keyframes subirApoiadorDriftLeft { 
  0% { opacity: 0; transform: translateY(30px); }
  8% { opacity: var(--target-opacity,.6); }
  50% { transform: translate(-20px, calc(-60px - 50vh)); }
  90% { opacity: var(--target-opacity,.6); }
  100% { opacity: 0; transform: translate(-10px, calc(-120px - 100vh)); }
}

@keyframes subirApoiadorDriftRight { 
  0% { opacity: 0; transform: translateY(30px); }
  8% { opacity: var(--target-opacity,.6); }
  50% { transform: translate(20px, calc(-60px - 50vh)); }
  90% { opacity: var(--target-opacity,.6); }
  100% { opacity: 0; transform: translate(10px, calc(-120px - 100vh)); }
}

@media (prefers-reduced-motion: reduce) {
  .chuva-apoiadores-container { display: none !important; }
}

@media (width <= 680px) {
  .chuva-item { font-size: calc(var(--fs,16px) * .7) !important; }
}

.movie-player { background: rgb(0, 0, 0); justify-content: center; align-items: center; width: 100%; height: 100%; max-height: 100dvh; display: flex; position: relative; overflow: hidden; }

.movie-player.hide-cursor { cursor: none; }

.movie-player.fullscreen { z-index: 9999; max-height: none; position: fixed; inset: 0px; }

.video-container { justify-content: center; align-items: center; width: 100%; max-width: 1920px; height: 100%; max-height: calc(100dvh - 64px); margin: 0px auto; display: flex; position: relative; }

.movie-player.fullscreen .video-container { max-width: none; max-height: none; }

.movie-video { object-fit: contain; background: rgb(0, 0, 0); width: 100%; max-width: 1920px; height: 100%; max-height: 1080px; }

.movie-player.fullscreen .movie-video { max-width: none; max-height: none; }

.movie-player.empty { background: linear-gradient(135deg, rgb(15, 15, 15) 0%, rgb(26, 26, 46) 100%); }

.empty-state { text-align: center; color: rgb(136, 136, 136); padding: 40px; }

.empty-state svg { opacity: 0.5; width: 80px; height: 80px; margin-bottom: 20px; }

.empty-state h3 { color: rgb(255, 255, 255); margin-bottom: 8px; font-size: 1.5rem; }

.empty-state p { color: rgb(102, 102, 102); font-size: 1rem; }

.player-overlay { z-index: 10; background: rgba(0, 0, 0, 0.8); flex-direction: column; justify-content: center; align-items: center; display: flex; position: absolute; inset: 0px; }

.player-overlay.loading .spinner { border-width: 3px; border-style: solid; border-color: rgb(139, 92, 246) rgba(255, 255, 255, 0.2) rgba(255, 255, 255, 0.2); border-image: none; border-radius: 50%; width: 48px; height: 48px; margin-bottom: 16px; animation: 1s linear 0s infinite normal none running spin; }

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

.player-overlay.loading span { color: rgb(255, 255, 255); font-size: 0.9rem; }

.player-overlay.error, .player-overlay.loading { top: 96px; }

.player-overlay.error svg { color: rgb(239, 68, 68); width: 64px; height: 64px; margin-bottom: 16px; }

.player-overlay.error h3 { color: rgb(255, 255, 255); text-align: center; max-width: 400px; margin-bottom: 16px; font-size: 1.2rem; }

.error-actions { gap: 12px; margin-bottom: 16px; display: flex; }

.error-actions button { color: rgb(255, 255, 255); cursor: pointer; background: rgb(139, 92, 246); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; padding: 12px 24px; font-weight: 500; transition: background 0.2s; }

.error-actions button:hover { background: rgb(124, 58, 237); }

.error-actions button:last-child { background: rgba(255, 255, 255, 0.1); }

.error-actions button:last-child:hover { background: rgba(255, 255, 255, 0.2); }

.external-players { text-align: center; margin-top: 16px; }

.external-players p { color: rgb(136, 136, 136); margin-bottom: 12px; font-size: 0.85rem; }

.player-buttons { flex-wrap: wrap; justify-content: center; gap: 8px; display: flex; }

.player-buttons button { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 6px; padding: 8px 16px; font-size: 0.85rem; transition: 0.2s; }

.player-buttons button:hover { background: rgba(139, 92, 246, 0.3); border-color: rgba(139, 92, 246, 0.5); }

.error-hint { color: rgb(102, 102, 102); text-align: center; font-size: 0.85rem; }

.player-controls { opacity: 0; pointer-events: none; background: linear-gradient(rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 20%, rgba(0, 0, 0, 0) 80%, rgba(0, 0, 0, 0.9) 100%); flex-direction: column; justify-content: space-between; transition: opacity 0.3s; display: flex; position: absolute; inset: 0px; }

.player-controls.visible { opacity: 1; pointer-events: auto; }

.controls-top { z-index: 11; align-items: center; gap: 16px; padding: 16px 20px; display: flex; position: relative; }

.movie-title-bar { flex: 1 1 0%; min-width: 0px; }

.movie-title-bar h2 { color: rgb(255, 255, 255); white-space: nowrap; text-overflow: ellipsis; margin: 0px; font-size: 1.2rem; font-weight: 600; overflow: hidden; }

.movie-category { color: rgb(136, 136, 136); font-size: 0.85rem; }

.top-actions { gap: 8px; display: flex; }

.external-menu-wrapper { position: relative; }

.external-dropdown { backdrop-filter: blur(10px); z-index: 100; background: rgba(20, 20, 30, 0.95); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; min-width: 160px; margin-top: 8px; padding: 8px 0px; animation: 0.15s ease 0s 1 normal none running fadeIn; position: absolute; top: 100%; right: 0px; }

.external-dropdown button { color: rgb(255, 255, 255); text-align: left; cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; width: 100%; padding: 10px 16px; font-size: 0.9rem; transition: background 0.2s; display: block; }

.external-dropdown button:hover { background: rgba(139, 92, 246, 0.3); }

.external-dropdown hr { border-width: 1px medium medium; border-style: solid none none; border-color: rgba(255, 255, 255, 0.1) currentcolor currentcolor; border-image: none; margin: 8px 0px; }

.center-play { cursor: pointer; z-index: 5; background: rgba(139, 92, 246, 0.9); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; justify-content: center; align-items: center; width: 80px; height: 80px; transition: 0.2s; display: flex; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }

.center-play:hover { background: rgb(139, 92, 246); transform: translate(-50%, -50%) scale(1.1); }

.center-play svg { color: rgb(255, 255, 255); width: 40px; height: 40px; margin-left: 4px; }

.controls-bottom { padding: 0px 20px 16px; }

.progress-container { touch-action: none; cursor: pointer; background: rgba(255, 255, 255, 0.2); border-radius: 3px; height: 6px; margin-bottom: 12px; transition: height 0.2s; position: relative; }

.progress-container::before { content: ""; position: absolute; inset: -11px 0px; }

.progress-container:hover { height: 10px; }

.progress-buffered { pointer-events: none; background: rgba(255, 255, 255, 0.3); border-radius: 3px; height: 100%; position: absolute; top: 0px; left: 0px; }

.progress-played { pointer-events: none; background: rgb(139, 92, 246); border-radius: 3px; height: 100%; position: absolute; top: 0px; left: 0px; }

.progress-thumb { opacity: 0; background: rgb(255, 255, 255); border-radius: 50%; width: 14px; height: 14px; transition: opacity 0.2s; position: absolute; top: 50%; transform: translate(-50%, -50%); box-shadow: rgba(0, 0, 0, 0.3) 0px 2px 4px; }

.progress-container:hover .progress-thumb { opacity: 1; }

.controls-row { justify-content: space-between; align-items: center; display: flex; }

.controls-left, .controls-right { align-items: center; gap: 8px; display: flex; }

.control-btn { color: rgb(255, 255, 255); cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; justify-content: center; align-items: center; width: 40px; height: 40px; transition: background 0.2s; display: flex; }

.control-btn:hover { background: rgba(255, 255, 255, 0.1); }

.back-btn { background: rgba(0, 0, 0, 0.5); width: 44px; height: 44px; }

.back-btn:hover { background: rgba(139, 92, 246, 0.5); }

.volume-slider { opacity: 0; appearance: none; cursor: pointer; background: rgba(255, 255, 255, 0.3); border-radius: 2px; width: 0px; height: 4px; transition: width 0.2s, opacity 0.2s; }

.volume-control:hover .volume-slider { opacity: 1; width: 80px; }

.volume-slider::-webkit-slider-thumb { appearance: none; cursor: pointer; background: rgb(255, 255, 255); border-radius: 50%; width: 14px; height: 14px; }

.time-display { color: rgb(255, 255, 255); font-variant-numeric: tabular-nums; margin-left: 8px; font-size: 0.85rem; }

.time-resolution-display { align-items: center; gap: 10px; margin-left: 8px; display: flex; }

.time-resolution-display .time-display { margin-left: 0px; }

.video-resolution { color: rgb(255, 255, 255); text-transform: uppercase; letter-spacing: 0.5px; background: linear-gradient(135deg, rgba(99, 102, 241, 0.9), rgba(139, 92, 246, 0.9)); border-radius: 4px; padding: 3px 8px; font-size: 0.7rem; font-weight: 600; }

.speed-select { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.1); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 6px; outline: none; padding: 6px 10px; font-size: 0.85rem; }

.speed-select:hover { background: rgba(255, 255, 255, 0.2); }

.speed-select option { color: rgb(255, 255, 255); background: rgb(26, 26, 46); }

@media (width <= 768px) {
  .controls-top { padding: 12px 16px; }
  .movie-title-bar h2 { font-size: 1rem; }
  .controls-bottom { padding: 0px 16px 12px; }
  .control-btn { width: 36px; height: 36px; }
  .control-btn svg { width: 20px; height: 20px; }
  .center-play { width: 64px; height: 64px; }
  .center-play svg { width: 32px; height: 32px; }
  .volume-control:hover .volume-slider { width: 60px; }
  .time-display { font-size: 0.75rem; }
  .speed-select { padding: 4px 8px; font-size: 0.8rem; }
}

@media (hover: none) {
  .progress-thumb { opacity: 1; }
  .volume-slider { opacity: 1; width: 60px; }
}

.next-episode-overlay { z-index: 15; animation: 0.3s ease-out 0s 1 normal none running slideInRight; position: absolute; bottom: 100px; right: 24px; }

@keyframes slideInRight { 
  0% { opacity: 0; transform: translate(20px); }
  100% { opacity: 1; transform: translate(0px); }
}

.next-episode-card { backdrop-filter: blur(10px); background: rgba(20, 20, 20, 0.95); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; align-items: center; gap: 16px; padding: 16px 20px; display: flex; box-shadow: rgba(0, 0, 0, 0.5) 0px 8px 32px; }

.next-episode-info { flex-direction: column; gap: 4px; display: flex; }

.next-label { color: rgb(136, 136, 136); text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.75rem; }

.next-episode-info h4 { color: rgb(255, 255, 255); white-space: nowrap; text-overflow: ellipsis; max-width: 200px; margin: 0px; font-size: 1rem; overflow: hidden; }

.next-episode-number { color: rgb(139, 92, 246); font-size: 0.8rem; }

.next-episode-btn { color: rgb(255, 255, 255); cursor: pointer; background: rgb(139, 92, 246); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; align-items: center; gap: 8px; padding: 12px 20px; font-size: 0.9rem; font-weight: 600; transition: 0.2s; display: flex; }

.next-episode-btn svg { width: 20px; height: 20px; }

.next-episode-btn:hover { background: rgb(124, 58, 237); transform: scale(1.05); }

.next-dismiss-btn { color: rgb(102, 102, 102); cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; padding: 8px; transition: 0.2s; }

.next-dismiss-btn:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.1); }

.next-dismiss-btn svg { width: 16px; height: 16px; }

.next-ep-btn { position: relative; }

.next-ep-btn::after { content: "Próx"; color: rgb(139, 92, 246); opacity: 0; font-size: 0.65rem; transition: opacity 0.2s; position: absolute; bottom: -16px; left: 50%; transform: translate(-50%); }

.next-ep-btn:hover::after { opacity: 1; }

.skip-intro-btn { color: rgb(255, 255, 255); cursor: pointer; z-index: 15; background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 8px; align-items: center; gap: 8px; padding: 12px 20px; font-size: 0.95rem; font-weight: 600; transition: 0.2s; animation: 0.3s ease 0s 1 normal none running slideInRight; display: flex; position: absolute; bottom: 120px; right: 24px; }

.skip-intro-btn:hover { background: rgba(255, 255, 255, 0.25); transform: scale(1.02); }

.skip-intro-btn:active { transform: scale(0.98); }

.settings-menu-wrapper { position: relative; }

.settings-dropdown { background: rgba(20, 20, 28, 0.98); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; min-width: 240px; max-height: 400px; margin-bottom: 8px; padding: 12px; animation: 0.2s ease 0s 1 normal none running fadeInUp; position: absolute; bottom: 100%; right: 0px; overflow-y: auto; box-shadow: rgba(0, 0, 0, 0.5) 0px 8px 32px; }

@keyframes fadeInUp { 
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.settings-section { flex-direction: column; gap: 6px; padding: 8px 0px; display: flex; }

.settings-section label { color: rgba(255, 255, 255, 0.7); font-size: 0.8rem; font-weight: 500; }

.settings-section select { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; outline: none; padding: 8px 12px; font-size: 0.9rem; transition: 0.2s; }

.settings-section select:hover { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.2); }

.settings-section select:focus { border-color: rgb(139, 92, 246); }

.settings-slider { appearance: none; cursor: pointer; background: rgba(255, 255, 255, 0.2); border-radius: 2px; outline: none; width: 100%; height: 4px; }

.settings-slider::-webkit-slider-thumb { appearance: none; cursor: pointer; background: rgb(139, 92, 246); border-radius: 50%; width: 14px; height: 14px; transition: transform 0.15s; }

.settings-slider::-webkit-slider-thumb:hover { transform: scale(1.2); }

.settings-dropdown hr { border-width: 1px medium medium; border-style: solid none none; border-color: rgba(255, 255, 255, 0.1) currentcolor currentcolor; border-image: none; margin: 8px 0px; }

.settings-shortcuts { padding: 8px 0px; }

.settings-shortcuts h4 { color: rgba(255, 255, 255, 0.9); margin-bottom: 8px; font-size: 0.85rem; font-weight: 600; }

.settings-shortcuts ul { flex-direction: column; gap: 4px; margin: 0px; padding: 0px; list-style: none; display: flex; }

.settings-shortcuts li { color: rgba(255, 255, 255, 0.6); align-items: center; gap: 6px; font-size: 0.75rem; display: flex; }

.settings-shortcuts kbd { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 4px; padding: 2px 6px; font-family: monospace; font-size: 0.7rem; display: inline-block; }

.speed-indicator { color: rgb(255, 255, 255); background: rgba(139, 92, 246, 0.3); border-radius: 4px; padding: 4px 8px; font-size: 0.75rem; font-weight: 600; }

.movie-video.aspect-auto { object-fit: contain; }

.movie-video.aspect-16\:9 { object-fit: fill; aspect-ratio: 16 / 9; }

.movie-video.aspect-4\:3 { object-fit: fill; aspect-ratio: 4 / 3; }

.movie-video.aspect-21\:9 { object-fit: fill; aspect-ratio: 21 / 9; }

@media (width <= 768px) {
  .next-episode-overlay { bottom: 120px; left: 16px; right: 16px; }
  .next-episode-card { flex-wrap: wrap; justify-content: center; gap: 12px; padding: 12px 16px; }
  .next-episode-info { flex: 1 1 0%; min-width: 120px; }
  .next-episode-info h4 { max-width: 150px; font-size: 0.9rem; }
  .next-episode-btn { padding: 10px 16px; font-size: 0.85rem; }
  .skip-intro-btn { padding: 10px 16px; font-size: 0.85rem; bottom: 140px; left: auto; right: 16px; }
  .settings-dropdown { min-width: 220px; max-height: 300px; right: -60px; }
  .settings-shortcuts { display: none; }
}

.cast-btn { position: relative; }

.cast-btn.active { color: rgb(99, 102, 241); }

.cast-btn.casting { animation: 2s ease 0s infinite normal none running cast-pulse; }

@keyframes cast-pulse { 
  0%, 100% { box-shadow: rgba(34, 197, 94, 0.4) 0px 0px; }
  50% { box-shadow: rgba(34, 197, 94, 0.3) 0px 0px 15px 5px; }
}

.cast-message { color: rgb(255, 255, 255); z-index: 100; backdrop-filter: blur(8px); background: rgba(0, 0, 0, 0.9); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; align-items: center; gap: 12px; padding: 12px 24px; font-size: 0.95rem; animation: 0.3s ease 0s 1 normal none running fadeInDown; display: flex; position: absolute; top: 80px; left: 50%; transform: translate(-50%); }

.cast-message svg { color: rgb(99, 102, 241); width: 24px; height: 24px; }

@keyframes fadeInDown { 
  0% { opacity: 0; transform: translate(-50%, -20px); }
  100% { opacity: 1; transform: translate(-50%); }
}

.cast-active-indicator { color: rgb(255, 255, 255); z-index: 100; background: linear-gradient(135deg, rgba(99, 102, 241, 0.9), rgba(139, 92, 246, 0.9)); border-radius: 30px; align-items: center; gap: 10px; padding: 10px 20px; font-size: 0.9rem; font-weight: 500; animation: 0.3s ease 0s 1 normal none running fadeIn; display: flex; position: absolute; top: 20px; left: 50%; transform: translate(-50%); box-shadow: rgba(99, 102, 241, 0.4) 0px 4px 20px; }

.cast-active-indicator svg { width: 20px; height: 20px; }

.cast-active-indicator button { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.2); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 15px; padding: 4px 12px; font-size: 0.8rem; transition: background 0.2s; }

.cast-modal { background: linear-gradient(145deg, rgb(30, 30, 46), rgb(21, 21, 32)); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; width: 90%; max-width: 420px; max-height: 90vh; padding: 28px; overflow-y: auto; box-shadow: rgba(0, 0, 0, 0.5) 0px 25px 50px; }

.cast-modal h3 { color: rgb(255, 255, 255); margin: 0px 0px 8px; font-size: 1.3rem; }

.cast-option { cursor: pointer; text-align: left; color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; align-items: center; gap: 14px; padding: 14px 16px; transition: 0.2s; display: flex; }

.cast-option span { font-size: 0.95rem; font-weight: 500; }

.cast-option small { color: rgb(136, 136, 136); margin-top: 2px; font-size: 0.75rem; font-weight: 400; display: block; }

.cast-modal-back { color: rgb(136, 136, 136); cursor: pointer; background: 0px 0px; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; width: 100%; margin-top: 16px; padding: 10px; font-size: 0.9rem; transition: 0.2s; }

.cast-modal-back:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.05); }

.cast-modal-close { color: rgb(136, 136, 136); cursor: pointer; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; width: 100%; margin-top: 16px; padding: 14px; font-size: 0.9rem; transition: 0.2s; }

.cast-options.external-players .cast-option.copy-url { border-style: dashed; }

.player-overlay.aviso { background: radial-gradient(circle at 50% 38%, rgba(139, 92, 246, 0.16), rgba(0, 0, 0, 0.92) 62%); justify-content: flex-start; padding: 24px; overflow-y: auto; }

.player-overlay.aviso > :first-child { margin-top: auto; }

.player-controls.com-erro .controls-bottom { visibility: hidden; }

.player-overlay.aviso > :last-child { margin-bottom: auto; }

.player-overlay.aviso .aviso-icone { color: rgb(167, 139, 250); width: 46px; height: 46px; margin-bottom: 14px; }

.player-overlay.aviso h3 { max-width: 620px; margin-bottom: 10px; font-size: 1.45rem; font-weight: 600; }

.aviso-texto { color: rgb(185, 185, 198); text-align: center; max-width: 600px; margin: 0px 0px 22px; font-size: 0.98rem; line-height: 1.5; }

.aviso-botao { color: rgb(255, 255, 255); cursor: pointer; background: linear-gradient(135deg, rgb(139, 92, 246), rgb(109, 40, 217)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 14px; align-items: center; gap: 12px; padding: 18px 34px; font-size: 1.1rem; font-weight: 600; transition: transform 0.2s, box-shadow 0.2s; display: inline-flex; box-shadow: rgba(109, 40, 217, 0.45) 0px 10px 30px; }

.aviso-botao svg { color: currentcolor; width: 22px; height: 22px; margin: 0px; }

.aviso-botao:hover { transform: translateY(-2px); box-shadow: rgba(109, 40, 217, 0.55) 0px 14px 38px; }

.aviso-dica { color: rgb(138, 138, 152); text-align: center; margin: 14px 0px 0px; font-size: 0.85rem; }

.aviso-fontes { text-align: center; width: 100%; max-width: 640px; margin-top: 26px; }

.aviso-fontes > p { color: rgb(138, 138, 152); margin: 0px 0px 10px; font-size: 0.85rem; }

.aviso-fontes-lista { flex-wrap: wrap; justify-content: center; gap: 8px; display: flex; }

.aviso-fontes-lista button { color: rgb(231, 231, 238); cursor: pointer; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 150px; padding: 10px 14px; transition: background 0.2s, border-color 0.2s; display: flex; }

.aviso-fontes-lista button:hover { background: rgba(255, 255, 255, 0.13); }

.aviso-fontes-lista button.atual { background: rgba(139, 92, 246, 0.18); border-color: rgb(139, 92, 246); }

.aviso-fontes-lista strong { font-size: 0.86rem; font-weight: 600; }

.aviso-fontes-lista span { color: rgb(154, 154, 168); text-overflow: ellipsis; white-space: nowrap; max-width: 190px; font-size: 0.75rem; overflow: hidden; }

@media (width <= 640px) {
  .player-overlay.aviso h3 { font-size: 1.15rem; }
  .aviso-botao { justify-content: center; width: 100%; padding: 16px 20px; }
}

.movie-player { --player-accent: #e50914; background: rgb(0, 0, 0); }

.video-container, .movie-video { max-width: none; max-height: 100dvh; }

.player-controls { background: linear-gradient(rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.25) 19%, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0) 67%, rgba(0, 0, 0, 0.9) 100%); }

.controls-top { padding: clamp(1rem, 2vw, 1.8rem) clamp(1rem, 2.5vw, 2.4rem); }

.movie-title-bar h2 { letter-spacing: -0.015em; font-size: clamp(1rem, 1.7vw, 1.35rem); font-weight: 700; }

.movie-category { color: rgba(255, 255, 255, 0.62); }

.back-btn, .episodes-menu-btn { background: rgba(0, 0, 0, 0.5); border-radius: 50%; }

.back-btn:hover, .episodes-menu-btn:hover, .episodes-menu-btn.active { background: rgba(255, 255, 255, 0.16); }

.progress-played { background: var(--player-accent); }

.center-play { background: rgba(229, 9, 20, 0.92); box-shadow: rgba(0, 0, 0, 0.4) 0px 10px 36px; }

.center-play:hover { background: rgb(242, 13, 24); }

.next-episode-number, .next-ep-btn::after { color: rgb(255, 107, 114); }

.next-episode-btn { background: var(--player-accent); }

.next-episode-btn:hover { background: rgb(242, 13, 24); }

.prev-ep-btn, .next-ep-btn { position: relative; }

.prev-ep-btn::after, .next-ep-btn::after { color: rgba(255, 255, 255, 0.68); opacity: 0; white-space: nowrap; font-size: 0.62rem; transition: opacity 0.15s; position: absolute; bottom: -16px; left: 50%; transform: translate(-50%); }

.prev-ep-btn::after { content: "Anterior"; }

.next-ep-btn::after { content: "Próximo"; }

.prev-ep-btn:hover::after, .next-ep-btn:hover::after { opacity: 1; }

.episode-browser-backdrop { z-index: 28; background: linear-gradient(90deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.66)); justify-content: flex-end; animation: 0.15s ease-out 0s 1 normal none running player-episodes-fade; display: flex; position: absolute; inset: 0px; }

@keyframes player-episodes-fade { 
  0% { opacity: 0; }
}

.episode-browser { background: rgba(18, 18, 18, 0.976); border-left: 1px solid rgba(255, 255, 255, 0.09); flex-direction: column; width: min(460px, 92vw); height: 100%; padding: 1.35rem; animation: 0.19s ease-out 0s 1 normal none running player-episodes-in; display: flex; box-shadow: rgba(0, 0, 0, 0.46) -24px 0px 70px; }

@keyframes player-episodes-in { 
  0% { opacity: 0.4; transform: translate(32px); }
}

.episode-browser-header { justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: 1rem; display: flex; }

.episode-browser-header span { color: rgb(255, 107, 114); letter-spacing: 0.11em; text-transform: uppercase; margin-bottom: 0.15rem; font-size: 0.68rem; font-weight: 800; display: block; }

.episode-browser-header h3 { text-overflow: ellipsis; white-space: nowrap; margin: 0px; font-size: 1.25rem; overflow: hidden; }

.episode-browser-header > button { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.09); border-radius: 50%; flex: 0 0 auto; place-items: center; width: 2.4rem; height: 2.4rem; font-size: 1.5rem; display: grid; }

.episode-browser-seasons { scrollbar-width: thin; gap: 0.45rem; padding: 0px 0px 0.9rem; display: flex; overflow-x: auto; }

.episode-browser-seasons button { color: rgba(255, 255, 255, 0.74); background: rgba(255, 255, 255, 0.043); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 0.35rem; flex: 0 0 auto; align-items: center; gap: 0.4rem; padding: 0.5rem 0.7rem; font-size: 0.78rem; display: flex; }

.episode-browser-seasons button.active { color: rgb(17, 17, 17); background: rgb(245, 245, 245); border-color: rgba(255, 255, 255, 0.72); font-weight: 700; }

.episode-browser-seasons small { opacity: 0.62; }

.episode-browser-list { flex-direction: column; gap: 0.35rem; min-height: 0px; padding-right: 0.2rem; display: flex; overflow-y: auto; }

.episode-browser-list > button { color: rgb(255, 255, 255); text-align: left; background: rgba(255, 255, 255, 0.043); border: 1px solid rgba(0, 0, 0, 0); border-radius: 0.5rem; align-items: center; gap: 0.85rem; width: 100%; padding: 0.65rem 0.8rem; transition: background 0.12s, border-color 0.12s; display: flex; }

.episode-browser-thumb { aspect-ratio: 16 / 9; object-fit: cover; background: rgba(255, 255, 255, 0.08); border-radius: 6px; flex-shrink: 0; width: 88px; height: 50px; }

.episode-browser-list > button:hover:not(:disabled) { background: rgba(255, 255, 255, 0.094); border-color: rgba(255, 255, 255, 0.12); }

.episode-browser-list > button.active { background: rgba(229, 9, 20, 0.11); border-color: rgba(229, 9, 20, 0.36); }

.episode-browser-list > button:disabled { cursor: default; opacity: 1; }

.episode-browser-play { border: 1px solid rgba(255, 255, 255, 0.34); border-radius: 50%; place-items: center; width: 1.8rem; height: 1.8rem; font-size: 0.58rem; display: grid; }

.episode-browser-list > button.active .episode-browser-play { color: rgb(255, 107, 114); border-color: rgba(0, 0, 0, 0); }

.episode-browser-copy { gap: 0.1rem; min-width: 0px; display: grid; }

.episode-browser-copy strong { font-size: 0.9rem; }

.episode-browser-copy small { color: rgba(255, 255, 255, 0.48); font-size: 0.7rem; }

.episode-browser-list em { color: rgb(255, 123, 130); font-size: 0.66rem; font-style: normal; font-weight: 700; }

@media (width <= 700px) {
  .episode-browser { width: 100%; padding: 1rem; }
  .controls-top { gap: 0.6rem; }
  .top-actions .external-menu-wrapper { display: none; }
  .movie-title-bar h2 { font-size: 0.95rem; }
  .movie-category { font-size: 0.72rem; }
}

.movie-video::cue { color: rgb(255, 255, 255); text-shadow: none; background: rgba(0, 0, 0, 0.72); font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size: 1.25em; line-height: 1.3; }

.legenda-msg { color: rgb(163, 163, 163); margin-top: 6px; font-size: 12px; display: block; }

.aviso-app { text-align: left; background: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.35); border-radius: 14px; flex-wrap: wrap; justify-content: center; align-items: center; gap: 18px; max-width: 640px; margin-top: 22px; padding: 14px 18px; display: flex; }

.aviso-app strong { color: rgb(255, 255, 255); margin-bottom: 3px; font-size: 0.95rem; display: block; }

.aviso-app span { color: rgb(168, 168, 182); max-width: 400px; font-size: 0.83rem; line-height: 1.45; display: block; }

.aviso-app-botao { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 10px; flex-shrink: 0; padding: 11px 20px; font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: background 0.2s; }

.aviso-app-botao:hover { background: rgba(255, 255, 255, 0.2); }

@media (width <= 640px) {
  .aviso-app { text-align: center; flex-direction: column; }
  .aviso-app span { max-width: none; }
  .aviso-app-botao { text-align: center; width: 100%; }
}

.program-info { opacity: 0; z-index: 25; pointer-events: none; will-change: opacity, transform; contain: layout style paint; background: linear-gradient(rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0)); padding: 0px; transition: opacity 0.4s, transform 0.4s; position: absolute; top: 0px; left: 0px; right: 0px; transform: translateY(-20px); }

.program-info.visible { opacity: 1; pointer-events: auto; transform: translateY(0px); }

.program-info.expanded { background: rgba(0, 0, 0, 0.95); }

.program-progress-bar { background: rgba(255, 255, 255, 0.1); height: 3px; position: relative; overflow: hidden; }

.program-progress-fill { background: linear-gradient(90deg, rgb(139, 92, 246), rgb(6, 182, 212)); height: 100%; transition: width 0.5s; position: relative; }

.program-progress-fill::after { content: ""; background: rgb(6, 182, 212); border-radius: 50%; width: 8px; height: 8px; position: absolute; top: 50%; right: 0px; transform: translateY(-50%); box-shadow: rgb(6, 182, 212) 0px 0px 10px; }

.program-content { align-items: flex-start; gap: 24px; padding: 20px 24px; display: flex; }

.current-program { flex: 1 1 0%; align-items: flex-start; gap: 12px; display: flex; }

.program-now-badge { color: rgb(255, 255, 255); text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; background: linear-gradient(135deg, rgb(239, 68, 68), rgb(220, 38, 38)); border-radius: 4px; flex-shrink: 0; align-items: center; gap: 6px; padding: 4px 10px; font-size: 10px; font-weight: 700; display: flex; }

.live-dot { background: rgb(255, 255, 255); border-radius: 50%; width: 6px; height: 6px; animation: 2s ease 0s infinite normal none running pulse-dot; }

@keyframes pulse-dot { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.program-details { flex: 1 1 0%; min-width: 0px; }

.program-title { color: rgb(255, 255, 255); margin: 0px 0px 6px; font-size: 16px; font-weight: 600; line-height: 1.3; }

.program-meta { flex-wrap: wrap; align-items: center; gap: 12px; display: flex; }

.program-time { color: rgb(136, 136, 136); font-size: 12px; }

.program-duration { color: rgb(102, 102, 102); background: rgba(255, 255, 255, 0.1); border-radius: 4px; padding: 2px 8px; font-size: 11px; }

.program-category { color: rgb(139, 92, 246); background: rgba(139, 92, 246, 0.15); border-radius: 4px; padding: 2px 8px; font-size: 11px; }

.program-rating { color: rgb(255, 255, 255); background: rgb(51, 51, 51); border-radius: 4px; padding: 2px 6px; font-size: 10px; font-weight: 700; }

.program-rating.rating-L { background: rgb(34, 197, 94); }

.program-rating.rating-10 { background: rgb(59, 130, 246); }

.program-rating.rating-12 { background: rgb(234, 179, 8); }

.program-rating.rating-14 { background: rgb(249, 115, 22); }

.program-rating.rating-16 { background: rgb(239, 68, 68); }

.program-rating.rating-18 { background: rgb(0, 0, 0); }

.program-description { color: rgb(136, 136, 136); -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin: 8px 0px 0px; font-size: 12px; line-height: 1.4; display: -webkit-box; overflow: hidden; }

.next-program { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; flex-shrink: 0; align-items: center; gap: 10px; padding: 10px 14px; display: flex; }

.program-next-badge { color: rgb(6, 182, 212); text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; font-size: 9px; font-weight: 700; }

.program-title-small { color: rgb(221, 221, 221); white-space: nowrap; text-overflow: ellipsis; max-width: 150px; margin: 0px; font-size: 13px; font-weight: 500; overflow: hidden; }

.program-time-small { color: rgb(102, 102, 102); font-size: 11px; }

.program-actions { flex-shrink: 0; gap: 10px; display: flex; }

.program-btn { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; align-items: center; gap: 8px; padding: 10px 14px; font-size: 13px; font-weight: 500; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; }

.program-btn:hover { background: rgba(255, 255, 255, 0.15); border-color: rgba(139, 92, 246, 0.4); transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px; }

.program-btn svg { width: 18px; height: 18px; }

.expand-btn { padding: 8px; }

.upcoming-programs { border-top: 1px solid rgba(255, 255, 255, 0.1); max-height: 300px; padding: 16px 20px; overflow-y: auto; }

.upcoming-title { color: rgb(136, 136, 136); text-transform: uppercase; letter-spacing: 1px; margin: 0px 0px 12px; font-size: 12px; font-weight: 600; }

.upcoming-list { flex-direction: column; gap: 8px; display: flex; }

.upcoming-item { background: rgba(255, 255, 255, 0.03); border-radius: 8px; align-items: center; gap: 12px; padding: 10px 12px; transition: background 0.2s; display: flex; }

.upcoming-item:hover { background: rgba(255, 255, 255, 0.06); }

.upcoming-time { color: rgb(139, 92, 246); min-width: 50px; font-size: 13px; font-weight: 600; }

.upcoming-info { flex: 1 1 0%; min-width: 0px; }

.upcoming-name { color: rgb(238, 238, 238); white-space: nowrap; text-overflow: ellipsis; font-size: 13px; font-weight: 500; display: block; overflow: hidden; }

.upcoming-category { color: rgb(102, 102, 102); font-size: 11px; }

.upcoming-duration { color: rgb(102, 102, 102); white-space: nowrap; font-size: 11px; }

.upcoming-programs::-webkit-scrollbar { width: 6px; }

.upcoming-programs::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); border-radius: 3px; }

.upcoming-programs::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.3); border-radius: 3px; }

.upcoming-programs::-webkit-scrollbar-thumb:hover { background: rgba(139, 92, 246, 0.5); }

@media (width <= 1024px) {
  .program-content { gap: 16px; }
  .program-title { font-size: 15px; }
}

@media (width <= 768px) {
  .program-content { flex-direction: column; gap: 12px; padding: 12px 16px; }
  .program-title { font-size: 14px; }
  .next-program { width: 100%; }
  .program-title-small { max-width: none; }
  .program-actions { justify-content: flex-end; width: 100%; }
  .program-now-badge { padding: 3px 8px; font-size: 9px; }
  .program-meta { gap: 8px; }
  .program-time, .program-duration, .program-category { font-size: 10px; }
  .upcoming-programs { max-height: 200px; padding: 12px 16px; }
}

@media (width <= 480px) {
  .program-content { gap: 10px; padding: 10px 12px; }
  .current-program { flex-direction: column; align-items: flex-start; gap: 8px; }
  .program-title { font-size: 13px; }
  .program-now-badge { padding: 2px 6px; font-size: 8px; }
  .program-meta { gap: 6px; }
  .program-time { font-size: 10px; }
  .program-duration, .program-category, .program-rating { padding: 2px 6px; font-size: 9px; }
  .program-description { -webkit-line-clamp: 1; font-size: 11px; }
  .next-program { padding: 8px 10px; }
  .program-next-badge { font-size: 8px; }
  .program-title-small { font-size: 12px; }
  .program-time-small { font-size: 10px; }
  .program-btn { padding: 6px 10px; font-size: 11px; }
  .program-btn svg { width: 14px; height: 14px; }
  .upcoming-programs { max-height: 180px; padding: 10px 12px; }
  .upcoming-title { margin-bottom: 10px; font-size: 11px; }
  .upcoming-item { gap: 10px; padding: 8px 10px; }
  .upcoming-time { min-width: 45px; font-size: 11px; }
  .upcoming-name { font-size: 12px; }
  .upcoming-category, .upcoming-duration { font-size: 10px; }
}

.video-player-container { cursor: none; will-change: auto; contain: layout style; background: rgb(0, 0, 0); flex: 1 1 0%; justify-content: center; align-items: center; min-height: 0px; max-height: 100%; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; position: relative; overflow: hidden; }

.video-player-container.show-controls { cursor: default; }

.video-player-container.theater { z-index: 100; position: fixed; inset: 0px; }

.video-element { object-fit: contain; z-index: 1; backface-visibility: hidden; background: rgb(0, 0, 0); width: 100%; height: 100%; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); position: relative; transform: translateZ(0px); }

.video-element.mirrored { transform: scaleX(-1) translateZ(0px); }

.video-element.aspect-auto { object-fit: contain; }

.video-element.aspect-16\:9 { object-fit: fill; aspect-ratio: 16 / 9; }

.video-element.aspect-4\:3 { object-fit: fill; aspect-ratio: 4 / 3; }

.video-element.aspect-fill { object-fit: cover; }

.aspect-ratio-hud { color: rgb(255, 255, 255); backdrop-filter: blur(20px); pointer-events: none; z-index: 50; background: rgba(10, 10, 15, 0.88); border: 1px solid rgba(79, 243, 224, 0.4); border-radius: 14px; align-items: center; gap: 12px; padding: 14px 26px; font-size: 1.15rem; font-weight: 600; animation: 0.16s ease-out 0s 1 normal none running hud-in; display: flex; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); box-shadow: rgba(0, 0, 0, 0.65) 0px 16px 48px; }

.aspect-ratio-hud svg { color: rgb(79, 243, 224); width: 26px; height: 26px; }

@keyframes hud-in { 
  0% { opacity: 0; transform: translate(-50%, -46%) scale(0.95); }
}

.no-channel { background: linear-gradient(135deg, rgb(10, 10, 10), rgb(26, 26, 26)); justify-content: center; align-items: center; width: 100%; height: 100%; display: flex; }

.no-channel-content { text-align: center; color: rgb(102, 102, 102); padding: 40px; }

.no-channel-content svg { opacity: 0.3; width: 120px; height: 120px; margin-bottom: 24px; }

.no-channel-content h2 { color: rgb(136, 136, 136); margin: 0px 0px 8px; font-size: 24px; font-weight: 600; }

.no-channel-content p { max-width: 300px; margin: 0px; font-size: 14px; }

.loading-overlay { z-index: 10; background: rgba(0, 0, 0, 0.8); flex-direction: column; justify-content: center; align-items: center; display: flex; position: absolute; inset: 0px; }

.center-play-btn { color: rgb(255, 255, 255); cursor: pointer; z-index: 50; opacity: 0.85; background: rgba(0, 0, 0, 0.7); border: 2px solid rgba(255, 255, 255, 0.25); border-radius: 50%; justify-content: center; align-items: center; width: 88px; height: 88px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); box-shadow: rgba(0, 0, 0, 0.4) 0px 8px 32px; }

.center-play-btn svg { filter: drop-shadow(rgba(0, 0, 0, 0.3) 0px 2px 4px); width: 40px; height: 40px; }

.center-play-btn:hover { opacity: 1; background: rgba(139, 92, 246, 0.7); border-color: rgba(168, 85, 247, 0.6); transform: translate(-50%, -50%) scale(1.12); box-shadow: rgba(139, 92, 246, 0.4) 0px 12px 48px; }

.center-play-btn:focus, .center-play-btn.dpad-focused, .center-play-btn[data-focused="true"] { opacity: 1; background: rgba(139, 92, 246, 0.85); border-color: rgb(168, 85, 247); outline: none; transform: translate(-50%, -50%) scale(1.18); box-shadow: rgba(168, 85, 247, 0.3) 0px 0px 0px 4px, rgba(168, 85, 247, 0.6) 0px 0px 48px, rgba(0, 0, 0, 0.4) 0px 12px 48px; }

.loader { width: 80px; height: 80px; position: relative; }

.loader-ring { border-width: 3px; border-style: solid; border-color: rgb(139, 92, 246) rgba(0, 0, 0, 0) rgba(0, 0, 0, 0); border-image: none; border-radius: 50%; animation: 1.5s linear 0s infinite normal none running spin; position: absolute; inset: 0px; }

.loader-ring:nth-child(2) { border-top-color: rgb(6, 182, 212); animation-duration: 1.2s; animation-direction: reverse; inset: 8px; }

.loader-ring:nth-child(3) { border-top-color: rgb(236, 72, 153); animation-duration: 0.9s; inset: 16px; }

.loading-overlay p { color: rgb(136, 136, 136); margin-top: 24px; font-size: 14px; }

.error-overlay { z-index: 10; color: rgb(239, 68, 68); background: rgba(0, 0, 0, 0.9); flex-direction: column; justify-content: center; align-items: center; display: flex; position: absolute; inset: 0px; }

.error-overlay svg { width: 64px; height: 64px; margin-bottom: 16px; }

.error-overlay p { color: rgb(136, 136, 136); margin: 0px 0px 20px; font-size: 16px; }

.retry-btn { color: rgb(255, 255, 255); cursor: pointer; background: linear-gradient(135deg, rgb(139, 92, 246), rgb(6, 182, 212)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; padding: 12px 24px; font-size: 14px; font-weight: 600; transition: 0.2s; }

.retry-btn:hover { transform: scale(1.05); box-shadow: rgba(139, 92, 246, 0.4) 0px 0px 20px; }

.http-overlay { text-align: center; color: rgb(241, 241, 241); z-index: 30; background: rgba(8, 8, 12, 0.94); padding: 24px; }

.http-overlay svg { color: rgb(251, 191, 36); width: 72px; height: 72px; }

.http-overlay h2 { color: rgb(255, 255, 255); max-width: 720px; margin: 0px 0px 12px; font-size: clamp(1.4rem, 3.2vw, 2.2rem); font-weight: 800; line-height: 1.2; }

.http-overlay .http-explica { color: rgba(255, 255, 255, 0.8); max-width: 620px; margin: 0px 0px 26px; font-size: clamp(1rem, 1.8vw, 1.2rem); line-height: 1.5; }

.http-overlay .http-explica strong { color: rgb(255, 255, 255); }

.http-open-btn { color: rgb(255, 255, 255); cursor: pointer; background: linear-gradient(135deg, rgb(139, 92, 246), rgb(236, 72, 153)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 16px; justify-content: center; align-items: center; gap: 12px; width: min(560px, 100%); padding: 20px 28px; font-size: clamp(1.05rem, 2.2vw, 1.35rem); font-weight: 800; transition: transform 0.15s, box-shadow 0.15s; display: inline-flex; box-shadow: rgba(236, 72, 153, 0.75) 0px 14px 40px -12px; }

.http-open-btn svg { color: rgb(255, 255, 255); flex-shrink: 0; width: 26px; height: 26px; margin: 0px; }

.http-open-btn:hover, .http-open-btn:focus-visible { outline-offset: 3px; outline: rgba(255, 255, 255, 0.85) solid 3px; transform: translateY(-2px) scale(1.02); box-shadow: rgba(236, 72, 153, 0.9) 0px 18px 44px -12px; }

.http-overlay .http-dica { color: rgba(255, 255, 255, 0.55); max-width: 560px; margin: 18px 0px 16px; font-size: 0.9rem; }

.retry-btn-secundario { background: rgba(255, 255, 255, 0.1); }

.video-veu-topo { pointer-events: none; z-index: 10; opacity: 0; background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0)); height: 120px; transition: opacity 0.22s; position: absolute; top: 0px; left: 0px; right: 0px; }

.video-veu-fundo { pointer-events: none; z-index: 10; opacity: 0; background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.6)); height: 220px; transition: opacity 0.22s; position: absolute; bottom: 0px; left: 0px; right: 0px; }

.video-player-container.show-controls .video-veu-topo, .video-player-container.show-controls .video-veu-fundo { opacity: 1; }

.video-floating-stack { z-index: 100; pointer-events: none; opacity: 0; box-sizing: border-box; flex-direction: column; align-items: flex-end; gap: 12px; padding: 0px 22px 20px; transition: opacity 0.22s, padding-left 0.3s cubic-bezier(0.16, 1, 0.3, 1); display: flex; position: absolute; bottom: 0px; left: 0px; right: 0px; }

.video-floating-stack.visible { opacity: 1; pointer-events: auto; }

.cartao-container-pos { pointer-events: auto; justify-content: flex-end; align-self: flex-end; width: 100%; display: flex; }

.video-glass-controlbar { color: rgb(255, 255, 255); box-sizing: border-box; pointer-events: auto; user-select: none; background: rgba(11, 14, 20, 0.85); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 24px; align-items: center; gap: 12px; width: 100%; padding: 10px 18px; display: flex; box-shadow: rgba(0, 0, 0, 0.5) 0px 16px 40px, rgba(255, 255, 255, 0.08) 0px 1px inset; }

.pill-channels-btn { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.1); border: 1.5px solid rgba(255, 255, 255, 0.18); border-radius: 50%; place-items: center; width: 40px; height: 40px; padding: 0px; transition: 0.2s; display: grid; position: relative; }

.pill-channels-btn svg { width: 19px; height: 19px; transition: transform 0.2s; }

.pill-channels-btn:hover { background: rgba(255, 255, 255, 0.22); border-color: rgba(255, 255, 255, 0.4); transform: scale(1.08); }

.pill-channels-btn.active { color: rgb(79, 227, 208); background: rgba(79, 227, 208, 0.22); border-color: rgb(79, 227, 208); box-shadow: rgba(79, 227, 208, 0.35) 0px 0px 16px; }

.pill-channels-btn.pulsing { animation: 2.4s ease-in-out 0s infinite normal none running canais-pulse-glow; }

.pill-channels-btn .pulse-indicator { background: rgb(79, 227, 208); border-radius: 50%; width: 8px; height: 8px; animation: 1.8s ease-in-out 0s infinite normal none running canais-dot-pulse; position: absolute; top: 4px; right: 4px; box-shadow: rgb(79, 227, 208) 0px 0px 8px; }

.pill-channels-btn.active .pulse-indicator { display: none; }

@keyframes canais-pulse-glow { 
  0%, 100% { border-color: rgba(79, 227, 208, 0.4); box-shadow: rgba(79, 227, 208, 0.35) 0px 0px; }
  50% { border-color: rgb(79, 227, 208); transform: scale(1.04); box-shadow: rgba(79, 227, 208, 0.5) 0px 0px 18px 4px; }
}

@keyframes canais-dot-pulse { 
  0%, 100% { opacity: 0.85; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.35); box-shadow: rgb(79, 227, 208) 0px 0px 12px, rgba(79, 227, 208, 0.6) 0px 0px 20px; }
}

.live-badge-mac { user-select: none; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 999px; align-items: center; gap: 6px; padding: 4px 10px; display: flex; }

.live-badge-dot { background: rgb(239, 68, 68); border-radius: 50%; width: 7px; height: 7px; animation: 2s ease-in-out 0s infinite normal none running liveBadgePulse; box-shadow: rgb(239, 68, 68) 0px 0px 8px; }

@keyframes liveBadgePulse { 
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.85); }
}

.live-badge-text { letter-spacing: 0.5px; color: rgb(255, 107, 107); font-size: 11px; font-weight: 800; }

.quality-badge-mac { color: rgb(255, 255, 255); font-variant-numeric: tabular-nums; background: rgba(255, 255, 255, 0.1); border-radius: 6px; padding: 4px 8px; font-size: 11px; font-weight: 600; }

.source-badge-mac { color: rgb(168, 180, 192); cursor: pointer; white-space: nowrap; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 12px; padding: 4px 10px; font-size: 11px; font-weight: 600; transition: 0.15s; }

.source-badge-mac:hover, .source-badge-mac.active { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.18); border-color: rgb(79, 227, 208); }

.live-badge-mac { letter-spacing: 0.5px; color: rgb(255, 255, 255); cursor: pointer; user-select: none; font-variant-numeric: tabular-nums; white-space: nowrap; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 12px; align-items: center; gap: 5px; padding: 4px 9px; font-size: 11px; font-weight: 700; transition: 0.2s; display: inline-flex; }

.live-badge-mac:hover { background: rgba(255, 255, 255, 0.18); transform: scale(1.02); }

.live-badge-mac.on-air { color: rgb(74, 222, 128); border-color: rgba(74, 222, 128, 0.3); }

.live-badge-mac.delayed { color: rgb(250, 204, 21); background: rgba(250, 204, 21, 0.12); border-color: rgba(250, 204, 21, 0.4); }

.live-badge-mac.delayed:hover { background: rgba(250, 204, 21, 0.22); border-color: rgba(250, 204, 21, 0.6); }

.live-dot { background: rgb(74, 222, 128); border-radius: 50%; width: 6px; height: 6px; display: inline-block; box-shadow: rgb(74, 222, 128) 0px 0px 6px; }

.live-dot.green { background: rgb(74, 222, 128); box-shadow: rgb(74, 222, 128) 0px 0px 6px; }

.live-dot.yellow { background: rgb(250, 204, 21); box-shadow: rgb(250, 204, 21) 0px 0px 6px; }

.control-btn.zero-delay-btn { justify-content: center; align-items: center; gap: 3px; width: auto; min-width: 40px; padding: 0px 8px; display: inline-flex; position: relative; }

.control-btn.zero-delay-btn.active-balanced { color: rgb(56, 189, 248); background: rgba(56, 189, 248, 0.14); border: 1px solid rgba(56, 189, 248, 0.45); }

.control-btn.zero-delay-btn.active-ultra { color: rgb(245, 158, 11); background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.6); animation: 2s ease-in-out 0s infinite normal none running zero-delay-pulse; }

@keyframes zero-delay-pulse { 
  0%, 100% { box-shadow: rgba(245, 158, 11, 0) 0px 0px; }
  50% { box-shadow: rgba(245, 158, 11, 0.4) 0px 0px 10px; }
}

.zero-delay-pill-text { letter-spacing: 0.6px; font-size: 9px; font-weight: 800; }

.zero-delay-toast { color: rgb(255, 255, 255); z-index: 100; pointer-events: none; background: rgba(15, 23, 42, 0.88); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; align-items: center; gap: 8px; padding: 8px 16px; font-size: 13px; font-weight: 600; animation: 0.25s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal none running zero-delay-toast-in; display: flex; position: absolute; top: 70px; left: 50%; transform: translate(-50%); box-shadow: rgba(0, 0, 0, 0.45) 0px 8px 24px; }

.zero-delay-toast svg { color: rgb(245, 158, 11); width: 14px; height: 14px; }

@keyframes zero-delay-toast-in { 
  0% { opacity: 0; transform: translate(-50%, -10px); }
  100% { opacity: 1; transform: translate(-50%); }
}

.volume-control-mac { align-items: center; gap: 6px; display: flex; }

.control-btn-icon { color: rgb(255, 255, 255); cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; justify-content: center; align-items: center; width: 32px; height: 32px; padding: 0px; transition: transform 0.15s; display: flex; }

.control-btn-icon:hover { color: rgb(79, 227, 208); transform: scale(1.1); }

.control-btn-icon svg { width: 18px; height: 18px; }

.volume-slider-mac { appearance: none; cursor: pointer; background: rgba(255, 255, 255, 0.2); border-radius: 2px; outline: none; width: 80px; height: 4px; transition: background 0.2s; }

.volume-slider-mac::-webkit-slider-thumb { appearance: none; cursor: pointer; background: rgb(255, 255, 255); border-radius: 50%; width: 12px; height: 12px; transition: transform 0.15s; box-shadow: rgba(0, 0, 0, 0.4) 0px 1px 4px; }

.volume-slider-mac::-webkit-slider-thumb:hover { background: rgb(79, 227, 208); transform: scale(1.25); }

.controlbar-spacer { flex: 1 1 0%; min-width: 8px; }

.speed-menu-container { position: relative; }

.glass-popup-menu { z-index: 1050; background: rgba(18, 22, 30, 0.95); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 14px; flex-direction: column; gap: 2px; min-width: 130px; padding: 6px; animation: 0.15s ease-out 0s 1 normal none running contextFadeIn; display: flex; position: absolute; bottom: calc(100% + 12px); right: 0px; box-shadow: rgba(0, 0, 0, 0.7) 0px 16px 40px; }

.glass-popup-header { letter-spacing: 0.5px; color: rgba(255, 255, 255, 0.4); text-transform: uppercase; padding: 6px 10px 4px; font-size: 11px; font-weight: 700; }

.glass-popup-item { color: rgb(255, 255, 255); text-align: left; cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; width: 100%; padding: 7px 10px; font-size: 13px; transition: background 0.12s; }

.glass-popup-item:hover { background: rgba(255, 255, 255, 0.1); }

.glass-popup-item.active { color: rgb(79, 227, 208); font-weight: 600; }

.control-btn { cursor: pointer; color: rgba(255, 255, 255, 0.88); background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; outline: none; flex-shrink: 0; justify-content: center; align-items: center; width: 38px; height: 38px; padding: 0px; transition: 0.15s cubic-bezier(0.16, 1, 0.3, 1); display: flex; }

.control-btn:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.12); transform: scale(1.08); }

.control-btn.active { color: rgb(79, 227, 208); background: rgba(79, 243, 224, 0.18); }

.control-btn::before { content: ""; opacity: 0; background: radial-gradient(circle, rgba(255, 255, 255, 0.1), rgba(0, 0, 0, 0) 70%); transition: opacity 0.3s; position: absolute; inset: 0px; }

.control-btn:hover { background: rgba(255, 255, 255, 0.15); border-color: rgba(255, 255, 255, 0.25); transform: translateY(-2px) scale(1.05); box-shadow: rgba(0, 0, 0, 0.3) 0px 8px 16px; }

.control-btn:hover::before { opacity: 1; }

.control-btn:focus, .control-btn.dpad-focused, .control-btn[data-focused="true"] { background: rgba(168, 85, 247, 0.4); border-color: rgb(168, 85, 247); transform: scale(1.1); box-shadow: rgba(168, 85, 247, 0.4) 0px 0px 0px 3px, rgba(168, 85, 247, 0.6) 0px 0px 20px; }

.control-btn.active { background: linear-gradient(135deg, rgba(139, 92, 246, 0.5), rgba(6, 182, 212, 0.5)); border-color: rgba(139, 92, 246, 0.6); }

.control-btn.cast-btn.casting { background: linear-gradient(135deg, rgba(34, 197, 94, 0.5), rgba(16, 185, 129, 0.5)); border-color: rgba(34, 197, 94, 0.6); animation: 2s ease-in-out 0s infinite normal none running cast-pulse; }

.control-btn svg { width: 22px; height: 22px; }

.volume-control { align-items: center; gap: 4px; display: flex; }

.volume-slider { opacity: 0; appearance: none; cursor: pointer; background: rgba(255, 255, 255, 0.2); border-radius: 2px; width: 0px; height: 4px; transition: 0.3s; }

.volume-control:hover .volume-slider, .volume-slider:focus, .volume-slider.dpad-focused, .volume-slider[data-focused="true"] { opacity: 1; width: 80px; margin-left: 4px; }

.volume-slider:focus, .volume-slider.dpad-focused, .volume-slider[data-focused="true"] { background: linear-gradient(90deg, rgb(168, 85, 247), rgba(255, 255, 255, 0.2)); outline: none; box-shadow: rgba(168, 85, 247, 0.4) 0px 0px 0px 2px, rgba(168, 85, 247, 0.6) 0px 0px 15px; }

.volume-slider::-webkit-slider-thumb { appearance: none; cursor: pointer; background: rgb(255, 255, 255); border-radius: 50%; width: 14px; height: 14px; box-shadow: rgba(0, 0, 0, 0.3) 0px 0px 10px; }

.channel-indicator { border-left: 1px solid rgba(255, 255, 255, 0.2); align-items: center; gap: 12px; margin-left: 16px; padding-left: 16px; display: flex; }

.live-badge { letter-spacing: 0.5px; color: rgb(255, 255, 255); background: rgb(239, 68, 68); border-radius: 4px; padding: 4px 10px; font-size: 11px; font-weight: 700; animation: 2s ease 0s infinite normal none running pulse-live; }

@keyframes pulse-live { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.channel-info { flex-direction: column; gap: 2px; display: flex; }

.channel-indicator .channel-name { color: rgb(255, 255, 255); font-size: 15px; font-weight: 600; line-height: 1.2; }

.video-resolution { color: rgb(6, 182, 212); letter-spacing: 0.3px; background: rgba(6, 182, 212, 0.15); border-radius: 4px; width: fit-content; padding: 2px 6px; font-size: 11px; font-weight: 600; }

@media (width <= 1024px) {
  .video-controls { padding: 16px; }
  .control-btn { width: 42px; height: 42px; }
}

@media (width <= 768px) {
  .video-player-container { flex: 1 1 0%; min-height: 0px; }
  .video-controls { flex-wrap: wrap; gap: 8px; padding: 12px; }
  .control-btn { width: 40px; height: 40px; }
  .control-btn svg { width: 18px; height: 18px; }
  .channel-indicator { display: none; }
  .volume-control:hover .volume-slider { width: 60px; }
  .no-channel { min-height: 50vh; }
  .no-channel-content svg { width: 80px; height: 80px; }
  .no-channel-content h2 { font-size: 18px; }
  .no-channel-content p { font-size: 13px; }
}

@media (width <= 480px) {
  .video-player-container { min-height: 0px; }
  .video-controls { gap: 6px; padding: 8px 10px; }
  .controls-left, .controls-right { gap: 4px; }
  .control-btn { border-radius: 8px; width: 36px; height: 36px; }
  .control-btn svg { width: 16px; height: 16px; }
  .volume-control:hover .volume-slider { width: 50px; }
  .no-channel-content { padding: 20px; }
  .no-channel-content svg { width: 60px; height: 60px; margin-bottom: 16px; }
  .no-channel-content h2 { font-size: 16px; }
  .no-channel-content p { max-width: 250px; font-size: 12px; }
  .loader { width: 60px; height: 60px; }
  .error-overlay svg { width: 48px; height: 48px; }
  .error-overlay p { font-size: 14px; }
  .retry-btn { padding: 10px 20px; font-size: 13px; }
}

.cast-message { color: rgb(255, 255, 255); z-index: 150; background: linear-gradient(145deg, rgba(139, 92, 246, 0.9), rgba(124, 58, 237, 0.9)); border-radius: 30px; align-items: center; gap: 10px; padding: 12px 24px; font-size: 14px; font-weight: 500; animation: 0.3s ease 0s 1 normal none running castMessageIn; display: flex; position: absolute; bottom: 100px; left: 50%; transform: translate(-50%); box-shadow: rgba(139, 92, 246, 0.4) 0px 8px 32px; }

.cast-message svg { width: 20px; height: 20px; }

@keyframes castMessageIn { 
  0% { opacity: 0; transform: translate(-50%) translateY(20px); }
  100% { opacity: 1; transform: translate(-50%) translateY(0px); }
}

.cast-active-indicator { color: rgb(255, 255, 255); z-index: 50; background: linear-gradient(145deg, rgba(139, 92, 246, 0.95), rgba(124, 58, 237, 0.95)); border-radius: 12px; align-items: center; gap: 10px; padding: 10px 16px; font-size: 13px; font-weight: 500; animation: 0.3s ease 0s 1 normal none running slideInRight; display: flex; position: absolute; top: 20px; right: 20px; box-shadow: rgba(139, 92, 246, 0.4) 0px 8px 32px; }

.cast-active-indicator svg { width: 18px; height: 18px; animation: 2s ease-in-out 0s infinite normal none running cast-pulse; }

.cast-active-indicator button { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.2); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 6px; margin-left: 8px; padding: 6px 12px; font-size: 12px; font-weight: 600; transition: background 0.2s; }

.cast-active-indicator button:hover { background: rgba(255, 255, 255, 0.3); }

.cast-modal-overlay { z-index: 100; backdrop-filter: blur(4px); background: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; animation: 0.2s ease 0s 1 normal none running fadeIn; display: flex; position: absolute; inset: 0px; }

.cast-modal { background: linear-gradient(145deg, rgb(26, 26, 46), rgb(22, 22, 42)); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 16px; width: 90%; max-width: 450px; max-height: 80vh; padding: 24px; animation: 0.3s ease 0s 1 normal none running slideUp; overflow-y: auto; box-shadow: rgba(0, 0, 0, 0.5) 0px 20px 60px, rgba(139, 92, 246, 0.1) 0px 0px 40px; }

@keyframes slideUp { 
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.cast-modal h3 { color: rgb(255, 255, 255); align-items: center; gap: 10px; margin: 0px 0px 8px; font-size: 20px; font-weight: 600; display: flex; }

.cast-modal > p { color: rgb(136, 136, 136); margin: 0px 0px 20px; font-size: 14px; }

.cast-options { flex-direction: column; gap: 10px; display: flex; }

.cast-options.external-players { max-height: 300px; padding-right: 8px; overflow-y: auto; }

.cast-options.external-players::-webkit-scrollbar { width: 6px; }

.cast-options.external-players::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); border-radius: 3px; }

.cast-options.external-players::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.4); border-radius: 3px; }

.cast-option { cursor: pointer; text-align: left; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; flex-wrap: wrap; align-items: center; gap: 12px; padding: 14px 16px; transition: 0.2s; display: flex; }

.cast-option:hover { background: rgba(139, 92, 246, 0.15); border-color: rgba(139, 92, 246, 0.4); transform: translate(4px); }

.cast-option svg { color: rgb(139, 92, 246); flex-shrink: 0; width: 28px; height: 28px; }

.cast-option span { color: rgb(255, 255, 255); flex: 1 1 0%; min-width: 100px; font-size: 15px; font-weight: 600; }

.cast-option small { color: rgb(136, 136, 136); width: 100%; margin-top: -4px; padding-left: 40px; font-size: 12px; }

.cast-option.copy-url { background: rgba(255, 255, 255, 0.02); border-style: dashed; }

.cast-option.active { background: rgba(139, 92, 246, 0.2); border-color: rgb(139, 92, 246); }

.cast-option.active svg { color: rgb(167, 139, 250); }

.cast-modal-back { color: rgb(139, 92, 246); cursor: pointer; background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 10px; width: 100%; margin-top: 12px; padding: 12px; font-size: 14px; font-weight: 500; transition: 0.2s; }

.cast-modal-back:hover { background: rgba(139, 92, 246, 0.2); }

.cast-modal-close { color: rgb(136, 136, 136); cursor: pointer; background: 0px 0px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 10px; width: 100%; margin-top: 12px; padding: 14px; font-size: 14px; font-weight: 500; transition: 0.2s; }

.cast-modal-close:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.3); }

@media (width <= 480px) {
  .cast-modal { border-radius: 12px; max-height: 85vh; padding: 20px; }
  .cast-modal h3 { font-size: 18px; }
  .cast-option { padding: 12px 14px; }
  .cast-option svg { width: 24px; height: 24px; }
  .cast-option span { font-size: 14px; }
  .cast-option small { padding-left: 36px; font-size: 11px; }
  .cast-message { padding: 10px 20px; font-size: 13px; bottom: 80px; }
  .cast-active-indicator { padding: 8px 12px; font-size: 12px; top: 10px; right: 10px; }
}

.video-player-container.multi-screen-mode { cursor: pointer; border-radius: 8px; }

.video-player-container.split-active { box-shadow: rgb(79, 243, 224) 0px 0px 0px 2px inset; }

.multi-screen-header { z-index: 25; pointer-events: auto; justify-content: space-between; align-items: center; gap: 8px; display: flex; position: absolute; top: 12px; left: 12px; right: 12px; }

.multi-badge { letter-spacing: 0.5px; text-transform: uppercase; color: rgb(136, 136, 136); backdrop-filter: blur(10px); cursor: pointer; user-select: none; background: rgba(10, 10, 15, 0.75); border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 20px; align-items: center; gap: 6px; padding: 5px 12px; font-size: 11px; font-weight: 700; transition: 0.2s; display: inline-flex; box-shadow: rgba(0, 0, 0, 0.4) 0px 4px 12px; }

.multi-badge.active { color: rgb(79, 243, 224); background: rgba(79, 243, 224, 0.2); border-color: rgba(79, 243, 224, 0.7); box-shadow: rgba(79, 243, 224, 0.35) 0px 0px 14px; }

.multi-badge:hover { transform: translateY(-1px); }

.multi-label { color: rgb(255, 255, 255); backdrop-filter: blur(10px); background: rgba(10, 10, 15, 0.75); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600; }

.multi-close-btn { color: rgb(255, 255, 255); cursor: pointer; backdrop-filter: blur(10px); background: rgba(15, 15, 20, 0.8); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 50%; justify-content: center; align-items: center; width: 28px; height: 28px; font-size: 13px; transition: 0.2s; display: inline-flex; }

.multi-close-btn:hover { background: rgba(239, 68, 68, 0.85); border-color: rgb(239, 68, 68); transform: scale(1.1); }

@media (width <= 768px) {
  .video-floating-stack { padding: 0px 8px 8px !important; }
  .video-glass-controlbar { scrollbar-width: none; border-radius: 16px; gap: 4px; padding: 6px 8px; overflow-x: auto; }
  .video-glass-controlbar::-webkit-scrollbar { display: none; }
  .control-btn { width: 32px; height: 32px; }
  .control-btn svg { width: 17px; height: 17px; }
  .volume-control-mac .volume-slider-mac { display: none; }
  .video-player-container:not(.theater-mode):not(:fullscreen) .cartao-container-pos { display: none; }
}

.dica-app { z-index: 30; color: rgb(255, 255, 255); backdrop-filter: blur(6px); background: rgba(15, 15, 25, 0.82); border-radius: 999px; align-items: center; gap: 10px; max-width: calc(100% - 24px); padding: 6px 6px 6px 12px; font-size: 13px; display: flex; position: absolute; bottom: 96px; left: 50%; transform: translate(-50%); }

.dica-app a { color: rgb(165, 180, 252); white-space: nowrap; font-weight: 600; text-decoration: none; }

.dica-app button { color: rgba(255, 255, 255, 0.7); cursor: pointer; background: 0px 0px; border: 0px; border-radius: 50%; place-items: center; width: 24px; height: 24px; padding: 0px; display: grid; }

.dica-app button svg { width: 16px; height: 16px; }
