.listas-erro { color: rgb(254, 202, 202); background: rgba(248, 113, 113, 0.12); border: 1px solid rgba(248, 113, 113, 0.4); border-radius: 14px; align-items: center; gap: 10px; padding: 10px 14px; font-size: 0.86rem; display: flex; }

.listas-erro svg { color: rgb(248, 113, 113); flex: 0 0 auto; }

.listas-botoes { flex-wrap: wrap; gap: 8px; margin-top: 4px; display: flex; }

.listas-botao { font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; cursor: pointer; color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 16px; padding: 9px 18px; font-size: 0.86rem; font-weight: 600; }

.listas-botao:hover { background: rgba(255, 255, 255, 0.16); }

.listas-botao:focus-visible { outline-offset: 2px; outline: rgba(79, 243, 224, 0.8) solid 2px; }

.listas-botao.principal { color: rgb(10, 10, 10); background: rgb(255, 255, 255); border-color: rgb(255, 255, 255); }

.listas-botao.principal:hover { background: rgb(230, 230, 239); }

.listas-botao:disabled { opacity: 0.6; cursor: default; }

.listas-rotulo { justify-content: space-between; align-items: center; gap: 8px; display: flex; }

.listas-apagar { font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; cursor: pointer; color: rgb(252, 165, 165); background: 0px 0px; border: 1px solid rgba(248, 113, 113, 0.4); border-radius: 12px; padding: 2px 10px; font-size: 0.76rem; font-weight: 600; }

.listas-apagar:hover { background: rgba(248, 113, 113, 0.12); }

