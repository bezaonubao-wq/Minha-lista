.vod-fundo-destaque img { object-fit: cover; object-position: center 25%; opacity: 0.85; width: 100%; height: 100%; transition: opacity 0.4s ease-in-out; animation: 0.35s ease 0s 1 normal forwards running vod-destaque-fadein; position: absolute; inset: 0px; }

