body { color: rgb(241, 241, 241); background: rgb(10, 10, 10); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; line-height: 1.5; overflow: clip auto; }

#root { width: 100%; min-height: 100vh; }

:focus-visible { outline-offset: 0px; outline: rgba(139, 92, 246, 0.5) solid 1px; }

::-webkit-scrollbar { width: 8px; height: 8px; }

::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.02); }

