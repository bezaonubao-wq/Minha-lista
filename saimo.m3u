  .video-player-container { min-height: 100vh; }
  .video-controls { padding: 8px 12px; }
  .control-btn { width: 36px; height: 36px; }
}

.atalhos-fundo { z-index: 10000; background: rgba(0, 0, 0, 0.7); justify-content: center; align-items: center; padding: 16px; display: flex; position: fixed; inset: 0px; }

