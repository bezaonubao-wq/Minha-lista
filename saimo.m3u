::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.15); }

::selection { color: rgb(255, 255, 255); background: rgba(139, 92, 246, 0.3); }

button { cursor: pointer; color: inherit; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-family: inherit; }

input { color: inherit; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font-family: inherit; }

