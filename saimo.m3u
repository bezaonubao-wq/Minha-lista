.app-header { z-index: 1000; background: linear-gradient(rgba(10, 10, 15, 0.95) 0%, rgba(10, 10, 15, 0.8) 70%, rgba(0, 0, 0, 0) 100%); align-items: center; height: 64px; padding: 0px 24px; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; position: fixed; top: 0px; left: 0px; right: 0px; transform: translateY(0px); }

.app-header.transparent { background: linear-gradient(rgba(10, 10, 15, 0.6) 0%, rgba(0, 0, 0, 0) 100%); }

.app-header.scrolled { backdrop-filter: blur(20px); background: rgba(10, 10, 15, 0.98); box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 30px; }

.app-header.hidden { transform: translateY(-100%); }

.app-header.visible { transform: translateY(0px); }

.header-container { justify-content: space-between; align-items: center; gap: 24px; width: 100%; max-width: 1800px; margin: 0px auto; display: flex; }

.header-left { flex-shrink: 0; align-items: center; gap: 16px; display: flex; }

.header-logo { cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; align-items: center; gap: 10px; padding: 6px; transition: 0.2s; display: flex; }

.header-logo:hover { background: rgba(255, 255, 255, 0.05); }

.logo-icon { width: 36px; height: 36px; }

.logo-icon svg { width: 100%; height: 100%; }

.logo-text { color: rgb(255, 255, 255); letter-spacing: -0.5px; font-size: 1.3rem; font-weight: 800; }

.logo-text span { background: linear-gradient(135deg, rgb(139, 92, 246) 0%, rgb(236, 72, 153) 100%) text; -webkit-text-fill-color: transparent; }

.header-back-btn { color: rgb(255, 255, 255); cursor: pointer; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; justify-content: center; align-items: center; width: 40px; height: 40px; transition: 0.2s; display: flex; }

.header-back-btn:hover { background: rgba(255, 255, 255, 0.15); transform: translate(-2px); }

.header-back-btn svg { width: 20px; height: 20px; }

.header-title { color: rgb(255, 255, 255); white-space: nowrap; text-overflow: ellipsis; max-width: 200px; margin: 0px; font-size: 1.1rem; font-weight: 600; overflow: hidden; }

.header-nav { background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 12px; align-items: center; gap: 8px; padding: 4px; display: flex; }

.nav-link { color: rgba(255, 255, 255, 0.6); cursor: pointer; white-space: nowrap; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; align-items: center; gap: 8px; padding: 10px 20px; font-size: 0.9rem; font-weight: 500; transition: 0.2s; display: flex; }

.nav-link svg { flex-shrink: 0; width: 18px; height: 18px; }

.nav-link:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.08); }

.nav-link.active { color: rgb(255, 255, 255); background: linear-gradient(135deg, rgb(139, 92, 246) 0%, rgb(124, 58, 237) 100%); box-shadow: rgba(139, 92, 246, 0.3) 0px 4px 15px; }

.header-right { flex-shrink: 0; align-items: center; gap: 12px; display: flex; }

.header-home-btn { color: rgba(255, 255, 255, 0.7); cursor: pointer; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; justify-content: center; align-items: center; width: 40px; height: 40px; transition: 0.2s; display: flex; }

.header-home-btn:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.2); }

.header-home-btn svg { width: 20px; height: 20px; }

.header-link-btn { color: rgba(255, 255, 255, 0.7); cursor: pointer; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; justify-content: center; align-items: center; width: 40px; height: 40px; transition: 0.2s; display: flex; }

.header-link-btn svg { width: 20px; height: 20px; }

.header-link-btn:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.2); }

.header-link-btn.discord:hover { color: rgb(113, 137, 218); border-color: rgba(113, 137, 218, 0.45); }

@media (width <= 900px) {
  .app-header { height: 56px; padding: 0px 16px; }
  .header-nav { padding: 3px; }
  .nav-link { padding: 8px 14px; font-size: 0.85rem; }
  .nav-link svg { width: 16px; height: 16px; }
  .logo-text { display: none; }
  .header-title { max-width: 150px; }
}

@media (width <= 640px) {
  .app-header { height: 52px; padding: 0px 12px; }
  .header-container { gap: 12px; }
  .header-nav { background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; flex: 1 1 0%; justify-content: center; gap: 4px; padding: 0px; }
  .nav-link { background: rgba(255, 255, 255, 0.05); border-radius: 8px; flex: 1 1 0%; justify-content: center; padding: 8px 10px; font-size: 0.75rem; }
  .nav-link span { display: none; }
  .nav-link svg { width: 20px; height: 20px; }
  .header-back-btn, .header-link-btn, .header-home-btn { width: 36px; height: 36px; }
  .header-back-btn svg, .header-link-btn svg, .header-home-btn svg { width: 18px; height: 18px; }
  .header-title { max-width: 120px; font-size: 1rem; }
  .logo-icon { width: 32px; height: 32px; }
}

.adult-badge { color: rgb(255, 255, 255); letter-spacing: 0.5px; background: linear-gradient(135deg, rgb(239, 68, 68), rgb(236, 72, 153)); border-radius: 4px; margin-left: 6px; padding: 2px 6px; font-size: 0.65rem; font-weight: 700; }

.pin-modal-backdrop { z-index: 10000; background: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; padding: 20px; animation: 0.2s ease 0s 1 normal none running fadeIn; display: flex; position: fixed; inset: 0px; }

@keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.pin-modal { background: linear-gradient(rgb(26, 26, 36) 0%, rgb(18, 18, 26) 100%); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; width: 100%; max-width: 380px; animation: 0.3s ease 0s 1 normal none running modalSlide; overflow: hidden; }

@keyframes modalSlide { 
  0% { opacity: 0; transform: scale(0.95) translateY(20px); }
  100% { opacity: 1; transform: scale(1) translateY(0px); }
}

.pin-modal-header { text-align: center; background: linear-gradient(rgba(139, 92, 246, 0.1) 0%, rgba(0, 0, 0, 0) 100%); padding: 32px 24px 20px; }

.pin-icon { background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.2)); border: 2px solid rgba(139, 92, 246, 0.3); border-radius: 50%; justify-content: center; align-items: center; width: 64px; height: 64px; margin: 0px auto 16px; display: flex; }

.pin-icon svg { color: rgb(139, 92, 246); width: 32px; height: 32px; }

.pin-modal-header h2 { color: rgb(255, 255, 255); margin: 0px 0px 8px; font-size: 1.3rem; font-weight: 700; }

.pin-modal-header p { color: rgba(255, 255, 255, 0.6); margin: 0px; font-size: 0.9rem; }

.pin-modal-content { padding: 24px; }

.pin-modal .pin-input { color: rgb(255, 255, 255); text-align: center; letter-spacing: 12px; background: rgba(255, 255, 255, 0.05); border: 2px solid rgba(255, 255, 255, 0.1); border-radius: 12px; width: 100%; padding: 16px; font-size: 2rem; font-weight: 700; transition: 0.2s; }

.pin-modal .pin-input:focus { background: rgba(139, 92, 246, 0.1); border-color: rgb(139, 92, 246); outline: none; box-shadow: rgba(139, 92, 246, 0.1) 0px 0px 0px 4px; }

.pin-modal .pin-input::placeholder { color: rgba(255, 255, 255, 0.3); letter-spacing: 8px; }

.pin-hint { color: rgba(255, 255, 255, 0.5); justify-content: center; align-items: center; gap: 6px; margin-top: 16px; font-size: 0.8rem; display: flex; }

.pin-hint svg { color: rgb(139, 92, 246); }

.pin-modal-actions { gap: 12px; padding: 0px 24px 24px; display: flex; }

.pin-modal-actions button { cursor: pointer; border-radius: 12px; flex: 1 1 0%; padding: 14px 20px; font-size: 0.95rem; font-weight: 600; transition: 0.2s; }

.pin-modal-actions .cancel-btn { color: rgba(255, 255, 255, 0.7); background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1); }

.pin-modal-actions .cancel-btn:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.12); }

.pin-modal-actions .unlock-btn { color: rgb(255, 255, 255); background: linear-gradient(135deg, rgb(139, 92, 246), rgb(236, 72, 153)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; box-shadow: rgba(139, 92, 246, 0.3) 0px 4px 15px; }

.pin-modal-actions .unlock-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: rgba(139, 92, 246, 0.4) 0px 6px 20px; }

.pin-modal-actions .unlock-btn:disabled { opacity: 0.5; cursor: not-allowed; }

.header-download-btn { color: rgb(255, 255, 255); height: 40px; font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; white-space: nowrap; cursor: pointer; background: linear-gradient(135deg, rgb(139, 92, 246), rgb(236, 72, 153)); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 10px; align-items: center; gap: 8px; padding: 0px 14px; font-size: 0.88rem; font-weight: 600; transition: filter 0.2s, transform 0.2s; display: flex; }

.header-download-btn svg { width: 18px; height: 18px; }

.header-download-btn:hover, .header-download-btn:focus-visible { filter: brightness(1.12); transform: translateY(-1px); }

@media (width <= 640px) {
  .header-download-btn { justify-content: center; width: 40px; padding: 0px; }
  .header-download-btn span { display: none; }
}

@media (width <= 768px) {
  .header-nav, .header-download-btn, .header-link-btn, .header-home-btn { display: none !important; }
  .logo-text { display: inline !important; }
}

.barra-topo { z-index: 900; background: rgba(20, 22, 38, 0.55); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 26px; align-items: center; gap: 12px; width: min(1240px, -32px + 100vw); height: 52px; padding: 0px 10px 0px 12px; transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), transform 0.28s cubic-bezier(0.16, 1, 0.3, 1); display: flex; position: fixed; top: 12px; left: 50%; transform: translate(-50%); box-shadow: rgba(0, 0, 0, 0.45) 0px 8px 32px, rgba(255, 255, 255, 0.08) 0px 1px inset; }

.barra-topo.oculta { opacity: 0; pointer-events: none; transform: translate(-50%, -75px); }

.barra-logo { letter-spacing: -0.01em; border-radius: 14px; align-items: center; gap: 8px; padding: 4px 8px; font-size: 1rem; font-weight: 700; transition: background 0.15s; display: flex; }

.barra-logo:hover { background: rgba(255, 255, 255, 0.08); }

.barra-logo svg { width: 26px; height: 26px; }

.barra-logo b { color: rgb(79, 243, 224); margin-left: 1px; font-weight: 800; }

.barra-logo .adult-badge { color: rgb(255, 255, 255); background: rgb(229, 72, 77); border-radius: 8px; padding: 1px 6px; font-size: 0.65rem; font-style: normal; font-weight: 800; }

.barra-abas { background: rgba(255, 255, 255, 0.04); border-radius: 22px; align-items: center; gap: 2px; margin: 0px auto; padding: 3px; display: flex; position: relative; }

.barra-abas button { z-index: 1; color: rgba(255, 255, 255, 0.68); white-space: nowrap; border-radius: 18px; align-items: center; gap: 7px; height: 34px; padding: 0px 14px; font-size: 0.86rem; font-weight: 600; transition: color 0.15s, background 0.15s; display: flex; position: relative; }

.barra-abas button svg { flex-shrink: 0; width: 16px; height: 16px; }

.barra-abas button:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.06); }

.barra-abas button.on { color: rgb(255, 255, 255); background: 0px 0px; }

.barra-abas button.destacada { color: rgb(79, 243, 224); }

.barra-abas button.destacada svg { color: rgb(79, 243, 224); filter: drop-shadow(rgba(79, 243, 224, 0.45) 0px 0px 5px); }

.barra-abas button.destacada:hover { color: rgb(255, 255, 255); background: rgba(79, 243, 224, 0.1); }

.barra-abas button.destacada.on { color: rgb(255, 255, 255); }

.barra-aba-dot { background: rgb(79, 243, 224); border-radius: 50%; flex-shrink: 0; width: 5px; height: 5px; margin-left: 1px; animation: 2.4s ease-in-out 0s infinite normal none running barraDotPulse; box-shadow: rgb(79, 243, 224) 0px 0px 6px; }

@keyframes barraDotPulse { 
  0%, 100% { opacity: 0.85; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.35); }
}

.barra-capsula { z-index: 0; background: linear-gradient(135deg, rgba(79, 243, 224, 0.28), rgba(163, 92, 240, 0.34)); border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 18px; height: 34px; transition: transform 0.28s cubic-bezier(0.3, 1.2, 0.4, 1), width 0.28s cubic-bezier(0.3, 1.2, 0.4, 1); position: absolute; top: 3px; left: 0px; box-shadow: rgba(79, 243, 224, 0.18) 0px 2px 14px; }

.barra-direita { align-items: center; gap: 6px; display: flex; }

.barra-discord { color: rgba(255, 255, 255, 0.7); border-radius: 50%; place-items: center; width: 36px; height: 36px; text-decoration: none; transition: background 0.15s, color 0.15s, transform 0.2s; display: grid; }

.barra-discord svg { width: 19px; height: 19px; }

.barra-discord:hover { color: rgb(88, 101, 242); background: rgba(88, 101, 242, 0.2); transform: scale(1.08); }

.barra-engrenagem { color: rgba(255, 255, 255, 0.7); border-radius: 50%; place-items: center; width: 36px; height: 36px; transition: background 0.15s, color 0.15s, transform 0.3s; display: grid; }

.barra-engrenagem svg { width: 18px; height: 18px; }

.barra-engrenagem:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.1); transform: rotate(40deg); }

.barra-engrenagem.on { color: rgb(79, 243, 224); }

.barra-relogio { font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, 0.75); padding: 0px 8px 0px 4px; font-size: 0.86rem; font-weight: 600; }

@media (width <= 1060px) {
