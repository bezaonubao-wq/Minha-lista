.ajustes { z-index: 1; max-width: 760px; margin: 0px auto; position: relative; }

.ajustes-bloco { background: rgba(12, 14, 26, 0.35); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 18px; margin: 1rem 0px; padding: 18px 20px; box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 20px; }

.ajustes-bloco h2 { font-size: 1.05rem; font-weight: 700; }

